# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Windows shell scripts must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts
*.ps1 text eol=lf

# Binary files
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.rgba binary
*.pdb binary

# GitHub Linguist language overrides
tools/** linguist-vendored
*.slint linguist-detectable=true
