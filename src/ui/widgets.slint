export component MiniMetricBox inherits Rectangle {
    in property <string> label;
    in property <string> val_text;
    in property <color> val_color: transparent;
    in property <bool> is_dark: true;

    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
    border-width: 1px;
    border-radius: 8px;
    height: 48px;

    VerticalLayout {
        alignment: center;
        spacing: 1px;

        Text {
            text: root.label;
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 15px;
            font-family: "Cascadia Mono";
            horizontal-alignment: center;
        }

        Text {
            text: root.val_text;
            color: root.val_color != transparent ? root.val_color : (root.val_text == "--" ? (root.is_dark ? #475569 : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a));
            font-size: 18px;
            font-weight: 700;
            font-family: "Cascadia Mono";
            horizontal-alignment: center;
        }
    }
}

export component PatchItemRow inherits Rectangle {
    in property <string> title;
    in property <string> status_text;
    in property <bool> is_installed: false;
    in property <string> btn_text;
    in property <bool> is_dark: true;
    callback btn_clicked();

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 9px;
    height: 69px;

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 3px;

            Text {
                text: root.title;
                color: root.is_dark ? #f8fafc : #0f172a;
                font-size: 20px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 5px;
                    background: root.is_installed ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                    y: (parent.height - 9px) / 2;
                }
                Text {
                    text: root.status_text;
                    color: root.is_installed ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                    font-size: 17px;
                    font-family: "Cascadia Mono";
                }
            }
        }

        Rectangle {
            width: 102px;
            height: 42px;
            y: (parent.height - 42px) / 2;
            background: root.is_installed ? (ta.has_hover ? #f43f5e : rgba(244, 63, 94, 0.15)) : (ta.has_hover ? #34d399 : #10b981);
            border-color: root.is_installed ? #f43f5e : #10b981;
            border-width: 1px;
            border-radius: 8px;

            animate background { duration: 150ms; easing: ease-out; }

            ta := TouchArea {
                clicked => { root.btn_clicked(); }
                mouse-cursor: pointer;
            }

            Text {
                text: root.btn_text;
                color: root.is_installed ? (ta.has_hover ? #ffffff : #f43f5e) : #ffffff;
                font-size: 17px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
                animate color { duration: 150ms; easing: ease-out; }
            }
        }
    }
}

export component UserProfileRow inherits Rectangle {
    in property <string> user_name: "--";
    in property <string> user_email: "--";
    in property <string> tier: "";
    in property <image> avatar;
    in property <bool> has_avatar: false;
    in property <string> port_text: "";
    in property <bool> is_dark: true;

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 9px;
    height: 51px;

    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 14px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 8px;
                clip: true;
                background: root.is_dark ? #141c2b : #e2e8f0;
                y: (parent.height - 38px) / 2;

                if root.has_avatar : Image {
                    source: root.avatar;
                    width: 100%;
                    height: 100%;
                }
                if !root.has_avatar : Text {
                    text: root.user_name != "" && root.user_name != "--" ? "ID" : "--";
                    font-size: 15px;
                    color: root.is_dark ? #64748b : #94a3b8;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: root.user_name == "--" ? "未登录账号" : root.user_name;
                        color: root.user_name == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a);
                        font-size: 18px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if root.tier != "" : Rectangle {
                        background: root.is_dark ? rgba(16, 185, 129, 0.15) : rgba(16, 185, 129, 0.18);
                        border-color: root.is_dark ? rgba(16, 185, 129, 0.3) : rgba(16, 185, 129, 0.4);
                        border-width: 1px;
                        border-radius: 4px;
                        height: 20px;
                        y: (parent.height - 20px) / 2;

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.tier;
                                color: root.is_dark ? #34d399 : #059669;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.user_name == "--" ? "首次启动自动派生沙箱" : root.user_email;
                    overflow: elide;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}


export struct ModelQuotaRow {
    name: string,
    weekly_pct: string,
    weekly_ring: image,
    weekly_reset: string,
    five_h_pct: string,
    five_h_ring: image,
    five_h_reset: string,
    has_five_h: bool,
}

export component SubQuotaCompactBox inherits Rectangle {
    in property <[ModelQuotaRow]> model_quotas: [];
    in property <bool> is_dark: true;

    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
    border-width: 1px;
    border-radius: 9px;
    height: 61px + Math.max(1, root.model_quotas.length) * 44px;

    VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 6px;

        HorizontalLayout {
            height: 20px;
            alignment: space-between;

            Text {
                text: "模型额度";
                color: root.is_dark ? #94a3b8 : #64748b;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                text: "每周";
                width: 72px;
                horizontal-alignment: center;
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }

            Text {
                text: "5小时";
                width: 72px;
                horizontal-alignment: center;
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }
        }

        if root.model_quotas.length == 0 : HorizontalLayout {
            height: 42px;
            spacing: 3px;

            Text {
                text: "等待同步";
                horizontal-stretch: 1;
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 15px;
                vertical-alignment: center;
            }
        }

        for row in root.model_quotas : HorizontalLayout {
            height: 42px;
            alignment: space-between;

            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;

                Text {
                    text: row.name;
                    color: root.is_dark ? #cbd5e1 : #334155;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                width: 72px;
                alignment: center;
                spacing: 2px;

                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: row.weekly_pct;
                        width: 38px;
                        horizontal-alignment: right;
                        color: row.weekly_pct == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a);
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Image {
                        source: row.weekly_ring;
                        width: 20px;
                        height: 20px;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: row.weekly_reset;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 11px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
            }

            VerticalLayout {
                width: 72px;
                alignment: center;
                spacing: 2px;

                if row.has_five_h : HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: row.five_h_pct;
                        width: 38px;
                        horizontal-alignment: right;
                        color: row.five_h_pct == "0%" ? #ef4444 : (root.is_dark ? #f8fafc : #0f172a);
                        font-size: 15px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Image {
                        source: row.five_h_ring;
                        width: 20px;
                        height: 20px;
                        vertical-alignment: center;
                    }
                }

                if row.has_five_h : Text {
                    text: row.five_h_reset;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 11px;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if !row.has_five_h : HorizontalLayout {
                    alignment: center;
                    spacing: 4px;

                    Text {
                        text: "--";
                        width: 38px;
                        horizontal-alignment: right;
                        color: root.is_dark ? #334155 : #cbd5e1;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 20px;
                        height: 20px;
                    }
                }

                if !row.has_five_h : Rectangle {
                    height: 11px;
                }
            }
        }
    }
}

export component SubScaleCacheRow inherits Rectangle {
    in property <string> cache_text: "缓存 0 MB";
    in property <string> scale_text: "100%";
    in property <bool> is_dark: true;
    callback dec_clicked();
    callback inc_clicked();
    callback reset_clicked();

    height: 30px;

    HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.cache_text;
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 17px;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 5px;
            alignment: end;

            Text {
                text: "界面";
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 17px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 6px;
                background: b_dec.has_hover ? (root.is_dark ? #334155 : #cbd5e1) : (root.is_dark ? #1e293b : #e2e8f0);
                border-color: root.is_dark ? #334155 : #cbd5e1;
                border-width: 1px;
                y: (parent.height - 30px) / 2;
                b_dec := TouchArea {
                    clicked => { root.dec_clicked(); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "-";
                    color: root.is_dark ? #cbd5e1 : #334155;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: b_reset.has_hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #0d1527 : #ffffff);
                border-color: root.is_dark ? #334155 : #cbd5e1;
                border-width: 1px;
                y: (parent.height - 30px) / 2;
                b_reset := TouchArea {
                    clicked => { root.reset_clicked(); }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: root.scale_text;
                        color: root.is_dark ? #38bdf8 : #0284c7;
                        font-size: 17px;
                        font-family: "Cascadia Mono";
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 6px;
                background: b_inc.has_hover ? (root.is_dark ? #334155 : #cbd5e1) : (root.is_dark ? #1e293b : #e2e8f0);
                border-color: root.is_dark ? #334155 : #cbd5e1;
                border-width: 1px;
                y: (parent.height - 30px) / 2;
                b_inc := TouchArea {
                    clicked => { root.inc_clicked(); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "+";
                    color: root.is_dark ? #cbd5e1 : #334155;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
