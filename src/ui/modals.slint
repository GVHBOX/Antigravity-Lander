import { ScrollView } from "std-widgets.slint";
import { CompactButton, OutlineButton } from "buttons.slint";
import { SessionUiItem, SessionGroupHeader, SessionModalRow } from "session_items.slint";

export component ConfirmModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <int> slot: 0;
    in property <bool> is_dark: true;
    callback cancel();
    callback confirm(int);

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 525px;
            height: 231px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 12px;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 18px;

                Text {
                    text: "清理凭据";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 21px;
                    font-weight: 700;
                }

                Text {
                    text: root.slot == 0 ? "主账号 登录凭据" : ("分身 " + root.slot + " 登录凭据");
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 18px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    OutlineButton {
                        width: 114px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => { root.cancel(); }
                    }

                    CompactButton {
                        width: 126px;
                        text: "清理";
                        btn_color: #f43f5e;
                        is_dark: root.is_dark;
                        clicked => { root.confirm(root.slot); }
                    }
                }
            }
        }
    }
}

export component CleanCacheModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <string> detail_text: "";
    in property <string> total_text: "";
    in property <bool> is_dark: true;
    in-out property <int> clean_mode: 0;
    callback cancel();
    callback confirm(int);

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 600px;
            height: 480px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 12px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 14px;

                Text {
                    text: "存储管理与清理";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 21px;
                    font-weight: 700;
                }

                Text {
                    text: root.detail_text;
                    width: 100%;
                    wrap: word-wrap;
                    overflow: elide;
                    color: root.is_dark ? #cbd5e1 : #475569;
                    font-size: 16px;
                }

                Text {
                    text: root.total_text;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 16px;
                }

                Rectangle {
                    height: 54px;
                    border-radius: 8px;
                    background: root.clean_mode == 0 ? (root.is_dark ? rgba(56, 189, 248, 0.15) : rgba(56, 189, 248, 0.1)) : (root.is_dark ? #1e293b : #f1f5f9);
                    border-color: root.clean_mode == 0 ? #38bdf8 : transparent;
                    border-width: 1px;

                    TouchArea {
                        clicked => { root.clean_mode = 0; }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: root.clean_mode == 0 ? #38bdf8 : (root.is_dark ? #64748b : #94a3b8);
                            y: (parent.height - 16px) / 2;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.clean_mode == 0 ? #38bdf8 : transparent;
                                x: 2px;
                                y: 2px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "无损渲染缓存";
                                color: root.is_dark ? #f8fafc : #0f172a;
                                font-size: 15px;
                                font-weight: 600;
                            }

                            Text {
                                text: "清理 Web 与 GPU 渲染临时数据，保留全部会话";
                                color: root.is_dark ? #94a3b8 : #64748b;
                                font-size: 13px;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 54px;
                    border-radius: 8px;
                    background: root.clean_mode == 1 ? (root.is_dark ? rgba(244, 63, 94, 0.15) : rgba(244, 63, 94, 0.1)) : (root.is_dark ? #1e293b : #f1f5f9);
                    border-color: root.clean_mode == 1 ? #f43f5e : transparent;
                    border-width: 1px;

                    TouchArea {
                        clicked => { root.clean_mode = 1; }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;

                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: root.clean_mode == 1 ? #f43f5e : (root.is_dark ? #64748b : #94a3b8);
                            y: (parent.height - 16px) / 2;

                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.clean_mode == 1 ? #f43f5e : transparent;
                                x: 2px;
                                y: 2px;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "陈旧会话瘦身";
                                color: root.is_dark ? #f8fafc : #0f172a;
                                font-size: 15px;
                                font-weight: 600;
                            }

                            Text {
                                text: "清理 7 天前陈旧会话并同步索引";
                                color: root.is_dark ? #94a3b8 : #64748b;
                                font-size: 13px;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    OutlineButton {
                        width: 114px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => { root.cancel(); }
                    }

                    CompactButton {
                        width: 126px;
                        text: "清理";
                        btn_color: #f43f5e;
                        is_dark: root.is_dark;
                        clicked => { root.confirm(root.clean_mode); }
                    }
                }
            }
        }
    }
}

export component PatchModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <string> title_text: "";
    in property <string> msg_text: "";
    in property <string> btn_text: "";
    in property <bool> is_dark: true;
    callback cancel();
    callback confirm();

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 540px;
            height: 240px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 12px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 18px;

                Text {
                    text: root.title_text;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 21px;
                    font-weight: 700;
                }

                Text {
                    text: root.msg_text;
                    width: 100%;
                    wrap: word-wrap;
                    overflow: elide;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 18px;
                }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    OutlineButton {
                        width: 114px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => { root.cancel(); }
                    }

                    CompactButton {
                        width: 150px;
                        text: root.btn_text;
                        btn_color: #f43f5e;
                        is_dark: root.is_dark;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

export component SessionListModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <int> slot: 0;
    in property <[SessionUiItem]> items: [];
    in property <bool> is_dark: true;
    callback close();

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.75) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.close(); }
        }

        Rectangle {
            width: Math.min(parent.width - 120px, 1620px);
            height: Math.min(parent.height - 90px, 1140px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 18px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 15px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 48px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        Rectangle {
                            width: 6px;
                            height: 20px;
                            border-radius: 2px;
                            background: #38bdf8;
                            y: (parent.height - 20px) / 2;
                        }

                        Text {
                            text: root.slot == 0 ? "主账号 会话监视" : ("分身 " + root.slot + " 会话监视");
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 26px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 8px;
                        background: close_ta.has_hover ? (root.is_dark ? #1e293b : #e2e8f0) : transparent;

                        close_ta := TouchArea {
                            clicked => { root.close(); }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: "×";
                            color: root.is_dark ? #94a3b8 : #64748b;
                            font-size: 30px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.items.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "当前无活动会话记录";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 20px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if root.items.length > 0 : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-right: 30px;
                        padding-bottom: 12px;
                        spacing: 8px;
                        for item in root.items : VerticalLayout {
                            if item.is_group_header : SessionGroupHeader {
                                group_name: item.group_name;
                                count_str: item.group_count_str;
                                has_running: item.group_has_running;
                                is_dark: root.is_dark;
                            }
                            if !item.is_group_header : SessionModalRow {
                                item: item;
                                is_dark: root.is_dark;
                            }
                        }
                    }
                }
            }
        }
    }
}
