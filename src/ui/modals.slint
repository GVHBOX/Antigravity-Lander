import { ScrollView } from "std-widgets.slint";
import { CompactButton, OutlineButton } from "buttons.slint";
import { SessionUiItem, SessionGroupHeader, SessionModalRow } from "session_items.slint";

export component ConfirmModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <int> slot: 0;
    in property <bool> is_dark: true;
    callback cancel();
    callback confirm(int);

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 350px;
            height: 154px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 8px;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "清理凭据";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text {
                    text: root.slot == 0 ? "主账号 登录凭据" : ("分身 " + root.slot + " 登录凭据");
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    OutlineButton {
                        width: 76px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => { root.cancel(); }
                    }

                    CompactButton {
                        width: 84px;
                        text: "清理";
                        btn_color: #f43f5e;
                        is_dark: root.is_dark;
                        clicked => { root.confirm(root.slot); }
                    }
                }
            }
        }
    }
}

export component CleanCacheModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <string> detail_text: "";
    in property <string> total_text: "";
    in property <bool> is_dark: true;
    callback cancel();
    callback confirm();

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.cancel(); }
        }

        Rectangle {
            width: 400px;
            height: 236px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 8px;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "清理缓存";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text {
                    text: root.detail_text;
                    wrap: word-wrap;
                    color: root.is_dark ? #cbd5e1 : #475569;
                    font-size: 12px;
                }

                Text {
                    text: root.total_text;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    OutlineButton {
                        width: 76px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => { root.cancel(); }
                    }

                    CompactButton {
                        width: 84px;
                        text: "清理";
                        btn_color: #f43f5e;
                        is_dark: root.is_dark;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}

