export component SessionListModal inherits Rectangle {
    in property <bool> is_visible: false;
    in property <int> slot: 0;
    in property <[SessionUiItem]> items: [];
    in property <bool> is_dark: true;
    callback close();

    width: root.is_visible ? 100% : 0%;
    height: root.is_visible ? 100% : 0%;
    x: 0;
    y: 0;
    visible: root.is_visible;

    if root.is_visible : Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.75) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => { root.close(); }
        }

        Rectangle {
            width: Math.min(parent.width - 80px, 1080px);
            height: Math.min(parent.height - 60px, 760px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #1e1f22 : #ffffff;
            border-color: root.is_dark ? #33373e : #cbd5e1;
            border-width: 1px;
            border-radius: 12px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 32px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: #38bdf8;
                            y: (parent.height - 9px) / 2;
                        }

                        Text {
                            text: root.slot == 0 ? "主账号 会话监视" : ("分身 " + root.slot + " 会话监视");
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 5px;
                        background: close_ta.has_hover ? (root.is_dark ? #2b2d31 : #e2e8f0) : transparent;

                        close_ta := TouchArea {
                            clicked => { root.close(); }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: "×";
                            color: root.is_dark ? #94a3b8 : #64748b;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.items.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "当前无活动会话记录";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 13.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if root.items.length > 0 : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding-right: 20px;
                        padding-bottom: 8px;
                        spacing: 5px;
                        for item in root.items : VerticalLayout {
                            if item.is_group_header : SessionGroupHeader {
                                group_name: item.group_name;
                                count_str: item.group_count_str;
                                has_running: item.group_has_running;
                                is_dark: root.is_dark;
                            }
                            if !item.is_group_header : SessionModalRow {
                                item: item;
                                is_dark: root.is_dark;
                            }
                        }
                    }
                }
            }
        }
    }
}
