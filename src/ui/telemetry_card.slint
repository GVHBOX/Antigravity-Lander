export component TelemetryCard inherits Rectangle {
    in property <bool> live_session_is_running: false;
    in property <string> live_session_target_text: "分身 1";
    in property <int> live_session_target_slot: 1;
    in property <string> live_session_project: "暂无活动会话";
    in property <string> live_session_status_text: "空闲";
    in property <string> live_session_title: "";
    in property <string> live_session_speed_text: "0.0";
    in property <string> live_session_speed_sub: "当前轮次 0 Tokens · 0.0s";
    in property <float> live_bar0_h: 2.0;
    in property <float> live_bar1_h: 2.0;
    in property <float> live_bar2_h: 2.0;
    in property <float> live_bar3_h: 2.0;
    in property <float> live_bar4_h: 2.0;
    in property <float> live_bar5_h: 2.0;
    in property <float> live_bar6_h: 2.0;
    in property <float> live_bar7_h: 2.0;
    in property <string> live_session_context_text: "0 / 1.0M (0.0%)";
    in property <float> live_prompt_pct: 0.0;
    in property <float> live_cache_pct: 0.0;
    in property <float> live_output_pct: 0.0;
    in property <string> live_prompt_text: "输入 0";
    in property <string> live_cache_legend: "缓存 0 (0.0%)";
    in property <string> live_output_text: "输出 0";
    in property <string> live_session_available_text: "可用 1.0M";
    in property <string> live_session_optimization_text: "缓存节省 -- · 命中率 0.0%";
    in property <bool> is_dark: true;

    callback switch_target(int);
    callback show_history(int);

    horizontal-stretch: 3;
    min-width: 0px;
    preferred-width: 0px;
    max-height: 310px;
    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
    border-width: 1px;
    border-radius: 10px;
    clip: true;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;
            height: 22px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.live_session_is_running ? #10b981 : (root.is_dark ? #475569 : #94a3b8);
                    y: (parent.height - 8px) / 2;
                }
                Text {
                    text: "当前会话实时遥测";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 22px;
                border-radius: 4px;
                background: target_ta.has_hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);
                border-color: root.is_dark ? #162032 : #cbd5e1;
                border-width: 1px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    Text {
                        text: root.live_session_target_text;
                        color: #38bdf8;
                        font-size: 11px;
                        font-family: "Cascadia Mono";
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "▾";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                target_ta := TouchArea {
                    clicked => { root.switch_target(root.live_session_target_slot + 1); }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 44px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 2px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.live_session_project;
                        color: root.is_dark ? #f8fafc : #0f172a;
                        font-size: 12px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.live_session_status_text;
                        color: root.live_session_is_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                        font-size: 11px;
                        font-family: "Cascadia Mono";
                    }
                }
                Text {
                    text: root.live_session_title;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 62px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "单轮 Token 吞吐";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 11px;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.live_session_speed_text;
                            color: #10b981;
                            font-size: 18px;
                            font-weight: 700;
                            font-family: "Cascadia Mono";
                        }
                        Text {
                            text: "Tokens/s";
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 11px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: bottom;
                        }
                    }
                    Text {
                        text: root.live_session_speed_sub;
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 10px;
                        font-family: "Cascadia Mono";
                    }
                }

                HorizontalLayout {
                    spacing: 3px;
                    alignment: end;
                    Rectangle { width: 4px; height: root.live_bar0_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.35); y: parent.height - (root.live_bar0_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar1_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.45); y: parent.height - (root.live_bar1_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar2_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.55); y: parent.height - (root.live_bar2_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar3_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.65); y: parent.height - (root.live_bar3_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar4_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.75); y: parent.height - (root.live_bar4_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar5_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.85); y: parent.height - (root.live_bar5_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar6_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.90); y: parent.height - (root.live_bar6_h * 1px) - 14px; }
                    Rectangle { width: 4px; height: root.live_bar7_h * 1px; border-radius: 2px; background: #10b981; y: parent.height - (root.live_bar7_h * 1px) - 14px; }
                }
            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 56px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 3px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "上下文容量深度";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 11px;
                    }
                    Text {
                        text: root.live_session_context_text;
                        color: root.is_dark ? #f8fafc : #0f172a;
                        font-size: 12px;
                        font-weight: 700;
                        font-family: "Cascadia Mono";
                    }
                }
                bar_ctx := Rectangle {
                    height: 6px;
                    background: root.is_dark ? #141c2b : #e2e8f0;
                    border-radius: 3px;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_prompt_pct));
                        height: 6px;
                        background: #38bdf8;
                    }
                    Rectangle {
                        x: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_prompt_pct));
                        width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_cache_pct));
                        height: 6px;
                        background: #10b981;
                    }
                    Rectangle {
                        x: bar_ctx.width * (Math.min(1.0, Math.max(0.0, root.live_prompt_pct)) + Math.min(1.0, Math.max(0.0, root.live_cache_pct)));
                        width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_output_pct));
                        height: 6px;
                        background: #818cf8;
                    }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.live_prompt_text;
                        color: #38bdf8;
                        font-size: 10px;
                        font-family: "Cascadia Mono";
                    }
                    Text {
                        text: root.live_cache_legend;
                        color: #10b981;
                        font-size: 10px;
                        font-family: "Cascadia Mono";
                        font-weight: 600;
                    }
                    Text {
                        text: root.live_output_text;
                        color: #818cf8;
                        font-size: 10px;
                        font-family: "Cascadia Mono";
                    }
                    Text {
                        text: root.live_session_available_text;
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 10px;
                        font-family: "Cascadia Mono";
                    }
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            height: 22px;
            Text {
                text: root.live_session_optimization_text;
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 11px;
                font-family: "Cascadia Mono";
                vertical-alignment: center;
            }
            Rectangle {
                width: 100px;
                height: 22px;
                Text {
                    text: "会话完整历史 >";
                    color: hist_ta.has_hover ? #38bdf8 : (root.is_dark ? #64748b : #94a3b8);
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
                hist_ta := TouchArea {
                    clicked => { root.show_history(root.live_session_target_slot); }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
