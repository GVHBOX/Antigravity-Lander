
component HistBarCol inherits Rectangle {
    in property <float> bar_ratio: 0.0;
    in property <bool> is_latest: false;
    in property <bool> is_dark: true;
    callback hovered();
    callback unhovered();

    horizontal-stretch: 1;

    bar := Rectangle {
        y: parent.height - self.height;
        width: 7px;
        x: (parent.width - self.width) / 2;
        height: Math.max(4.5px, Math.min(root.height - 6px, root.bar_ratio * (root.height - 6px)));
        border-radius: 2px;
        background: ta.has-hover ? #38bdf8 : (root.is_latest ? #10b981 : (root.is_dark ? rgba(16, 185, 129, 0.38) : rgba(5, 150, 105, 0.42)));
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.hovered();
            } else {
                root.unhovered();
            }
        }
    }
}

export component TelemetryCard inherits Rectangle {
    in property <bool> live_session_is_running: false;
    in property <string> live_session_target_text: "分身 1";
    in property <int> live_session_target_slot: 1;
    in property <string> live_session_project: "暂无活动会话";
    in property <string> live_session_status_text: "";
    in property <string> live_session_title: "";
    in property <string> live_session_speed_text: "0.0";
    in property <string> live_session_speed_sub: "当前轮次 0 Tokens · 0.0s";
    in property <string> live_hover_tag: "";
    in property <bool> live_is_hovering_bar: false;
    in property <string> live_peak_tps_text: "峰值 0.0";
    in property <string> live_avg_tps_text: "Avg 0";
    in property <float> live_avg_line_pct: 0.5;

    in property <[float]> live_bars: [];

    in property <string> live_session_context_text: "0 / 256K (0.0%)";
    in property <float> live_session_context_pct: 0.0;
    in property <float> live_prompt_pct: 0.0;
    in property <float> live_cache_pct: 0.0;
    in property <float> live_output_pct: 0.0;
    property <float> ctx_total_raw: Math.max(0.0, root.live_prompt_pct) + Math.max(0.0, root.live_cache_pct) + Math.max(0.0, root.live_output_pct);
    property <float> ctx_scale: root.ctx_total_raw > 1.0 ? (1.0 / root.ctx_total_raw) : 1.0;
    property <float> ctx_prompt_w: Math.max(0.0, root.live_prompt_pct) * root.ctx_scale;
    property <float> ctx_cache_w: Math.max(0.0, root.live_cache_pct) * root.ctx_scale;
    property <float> ctx_output_w: Math.max(0.0, root.live_output_pct) * root.ctx_scale;
    property <float> ctx_used_pct: Math.min(1.0, Math.max(0.0, root.live_session_context_pct > 0.0 ? root.live_session_context_pct : root.ctx_total_raw));
    in property <string> live_prompt_text: "输入 0";
    in property <string> live_cache_legend: "缓存读取 0";
    in property <string> live_output_text: "输出 0";

    in property <string> live_model_name: "--";
    in property <string> live_model_level: "";
    in property <string> live_cache_hit_text: "缓存命中率 0.0%";
    in property <string> live_step_text: "步数 #0";
    in property <string> live_compact_text: "压缩 0 次";
    in property <bool> is_dark: true;


    callback switch_target(int);
    callback bar_hover(int);
    callback bar_leave();


    horizontal-stretch: 3;
    min-width: 0px;
    preferred-width: 0px;
    max-height: 150000px;
    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
    border-width: 1px;
    border-radius: 15px;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            alignment: space-between;
            height: 33px;
            HorizontalLayout {
                spacing: 9px;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.live_session_is_running ? #10b981 : (root.is_dark ? #475569 : #94a3b8);
                    y: (parent.height - 12px) / 2;
                }
                Text {
                    text: "状态";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 21px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 33px;
                border-radius: 6px;
                background: target_ta.has-hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);
                border-color: root.is_dark ? #162032 : #cbd5e1;
                border-width: 1px;
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    Text {
                        text: root.live_session_target_text;
                        color: #38bdf8;
                        font-size: 17px;
                        font-family: "Cascadia Mono";
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "▼";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                }
                target_ta := TouchArea {
                    clicked => { root.switch_target(root.live_session_target_slot + 1); }
                    mouse-cursor: pointer;
                }
            }
        }

        HorizontalLayout {
            spacing: 9px;
            height: 84px;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                background: root.is_dark ? #090e1c : #f8fafc;
                border-color: root.is_dark ? #162032 : #e2e8f0;
                border-width: 1px;
                border-radius: 9px;
                VerticalLayout {
                    padding-left: 15px;
                    padding-right: 15px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 3px;
                    Text {
                        text: "当前会话项目";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 17px;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: root.live_session_project;
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 18px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.live_session_status_text;
                            color: root.live_session_is_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                            font-size: 17px;
                            font-family: "Cascadia Mono";
                        }
                    }
                    Text {
                        text: root.live_session_title;
                        color: root.is_dark ? #94a3b8 : #64748b;
                        font-size: 17px;
                        overflow: elide;
                    }
                }
            }

            Rectangle {
                width: 312px;
                vertical-stretch: 1;
                background: root.is_dark ? #090e1c : #f8fafc;
                border-color: root.is_dark ? #162032 : #e2e8f0;
                border-width: 1px;
                border-radius: 9px;
                VerticalLayout {
                    padding-left: 15px;
                    padding-right: 15px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 3px;
                    alignment: start;
                    Text {
                        text: "模型";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 17px;
                        vertical-alignment: center;
                    }
                    Text {
                        height: 24px;
                        text: root.live_model_name;
                        color: root.is_dark ? #e2e8f0 : #1e293b;
                        font-size: 18px;
                        font-weight: 600;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.live_model_level;
                        color: root.is_dark ? #94a3b8 : #64748b;
                        font-size: 17px;
                        font-family: "Cascadia Mono";
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            height: 180px;

            Rectangle {
                background: root.is_dark ? #090e1c : #f8fafc;
                border-color: root.is_dark ? #162032 : #e2e8f0;
                border-width: 1px;
                border-radius: 9px;
                width: 285px;
                VerticalLayout {
                    padding-left: 15px;
                    padding-right: 15px;
                    padding-top: 11px;
                    padding-bottom: 11px;
                    alignment: space-between;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 9px;
                        alignment: start;
                        Text {
                            text: root.live_is_hovering_bar ? "历史轮次吞吐" : "单轮 Token 吞吐";
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 17px;
                            vertical-alignment: center;
                        }
                        if root.live_is_hovering_bar : Rectangle {
                            border-radius: 5px;
                            background: rgba(56, 189, 248, 0.15);
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: root.live_hover_tag;
                                    color: #38bdf8;
                                    font-size: 14px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 0px;
                        height: 56px;

                        Text {
                            text: root.live_session_speed_text;
                            color: root.live_is_hovering_bar ? #38bdf8 : #10b981;
                            font-size: 50px;
                            font-weight: 700;
                            vertical-alignment: bottom;
                        }

                        Rectangle {
                            width: 8px;
                        }

                        VerticalLayout {
                            alignment: end;
                            padding-bottom: 5px;
                            Text {
                                text: "Tokens/s";
                                color: root.is_dark ? #64748b : #94a3b8;
                                font-size: 13px;
                                font-weight: 500;
                            }
                        }
                    }

                    Text {
                        text: root.live_session_speed_sub;
                        color: root.is_dark ? #94a3b8 : #64748b;
                        font-size: 13px;
                        overflow: elide;
                    }
                }
            }

            Rectangle {
                background: root.is_dark ? #090e1c : #f8fafc;
                border-color: root.is_dark ? #162032 : #e2e8f0;
                border-width: 1px;
                border-radius: 9px;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding-left: 15px;
                    padding-right: 15px;
                    padding-top: 11px;
                    padding-bottom: 11px;
                    alignment: start;
                    spacing: 3px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 18px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 9px;
                            Text {
                                text: "吞吐趋势 (64轮)";
                                color: root.is_dark ? #64748b : #94a3b8;
                                font-size: 14px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.live_step_text;
                                color: root.is_dark ? #94a3b8 : #64748b;
                                font-size: 14px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.live_peak_tps_text;
                            color: #10b981;
                            font-size: 14px;
                            font-family: "Cascadia Mono";
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 108px;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: root.is_dark ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.08);
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            HistBarCol { bar_ratio: root.live_bars[0]; is_dark: root.is_dark; hovered => { root.bar_hover(0); } unhovered => { root.bar_leave(); } }
