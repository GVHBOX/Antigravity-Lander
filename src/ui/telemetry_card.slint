
component HistBarCol inherits Rectangle {
    in property <float> bar_h: 3.0;
    in property <bool> is_latest: false;
    in property <bool> is_dark: true;
    callback hovered();
    callback unhovered();

    horizontal-stretch: 1;
    height: 28px;

    bar := Rectangle {
        y: parent.height - self.height;
        width: 4.5px;
        x: (parent.width - self.width) / 2;
        height: Math.max(3.0, Math.min(28.0, root.bar_h)) * 1px;
        border-radius: 1.5px;
        background: ta.has-hover ? #38bdf8 : (root.is_latest ? #10b981 : (root.is_dark ? rgba(16, 185, 129, 0.38) : rgba(5, 150, 105, 0.42)));
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover) {
                root.hovered();
            } else {
                root.unhovered();
            }
        }
    }
}

export component TelemetryCard inherits Rectangle {
    in property <bool> live_session_is_running: false;
    in property <string> live_session_target_text: "分身 1";
    in property <int> live_session_target_slot: 1;
    in property <string> live_session_project: "暂无活动会话";
    in property <string> live_session_status_text: "";
    in property <string> live_session_title: "";
    in property <string> live_session_speed_text: "0.0";
    in property <string> live_session_speed_sub: "当前轮次 0 Tokens · 0.0s";
    in property <string> live_hover_tag: "";
    in property <bool> live_is_hovering_bar: false;
    in property <string> live_peak_tps_text: "峰值 0.0";
    in property <string> live_avg_tps_text: "Avg 0";
    in property <float> live_avg_line_pct: 0.5;

    in property <[float]> live_bars: [];

    in property <string> live_session_context_text: "0 / 256K (0.0%)";
    in property <float> live_prompt_pct: 0.0;
    in property <float> live_cache_pct: 0.0;
    in property <float> live_output_pct: 0.0;
    property <float> ctx_used_pct: Math.min(1.0, Math.max(0.0, root.live_prompt_pct + root.live_cache_pct + root.live_output_pct));
    in property <string> live_prompt_text: "输入 0";
    in property <string> live_cache_legend: "缓存读取 0";
    in property <string> live_output_text: "输出 0";

    in property <string> live_cache_hit_text: "缓存命中率 0.0%";
    in property <string> live_step_text: "步数 #0";
    in property <bool> is_dark: true;
    in property <string> widget_mode: "smart";

    callback switch_target(int);
    callback bar_hover(int);
    callback bar_leave();
    callback set_widget_mode(string);

    horizontal-stretch: 3;
    min-width: 0px;
    preferred-width: 0px;
    max-height: 310px;
    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
    border-width: 1px;
    border-radius: 10px;
    clip: true;

    VerticalLayout {
        padding: 10px;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;
            height: 22px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.live_session_is_running ? #10b981 : (root.is_dark ? #475569 : #94a3b8);
                    y: (parent.height - 8px) / 2;
                }
                Text {
                    text: "当前会话实时遥测";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 22px;
                border-radius: 4px;
                background: target_ta.has-hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);
                border-color: root.is_dark ? #162032 : #cbd5e1;
                border-width: 1px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    Text {
                        text: root.live_session_target_text;
                        color: #38bdf8;
                        font-size: 11px;
                        font-family: "Cascadia Mono";
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "▼";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 10px;
                        vertical-alignment: center;
                    }
                }
                target_ta := TouchArea {
                    clicked => { root.switch_target(root.live_session_target_slot + 1); }
                    mouse-cursor: pointer;
                }
            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 42px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                spacing: 1px;
                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.live_session_project;
                        color: root.is_dark ? #f8fafc : #0f172a;
                        font-size: 12px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.live_session_status_text;
                        color: root.live_session_is_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                        font-size: 11px;
                        font-family: "Cascadia Mono";
                    }
                }
                Text {
                    text: root.live_session_title;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 68px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 10px;

                VerticalLayout {
                    min-width: 150px;
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Text {
                            text: root.live_is_hovering_bar ? "历史轮次吞吐" : "单轮 Token 吞吐";
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        if root.live_is_hovering_bar : Rectangle {
                            border-radius: 3px;
                            background: rgba(56, 189, 248, 0.15);
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: root.live_hover_tag;
                                    color: #38bdf8;
                                    font-size: 9px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: root.live_session_speed_text;
                            color: root.live_is_hovering_bar ? #38bdf8 : #10b981;
                            font-size: 20px;
                            font-weight: 700;
                            font-family: "Cascadia Mono";
                        }
                        Text {
                            text: "Tokens/s";
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 10px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: bottom;
                        }
                    }

                    Text {
                        text: root.live_session_speed_sub;
                        color: root.is_dark ? #94a3b8 : #64748b;
                        font-size: 10px;
                        font-family: "Cascadia Mono";
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 12px;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text {
                                text: "吞吐趋势 (32轮)";
                                color: root.is_dark ? #64748b : #94a3b8;
                                font-size: 9px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.live_step_text;
                                color: root.is_dark ? #94a3b8 : #64748b;
                                font-size: 9px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.live_peak_tps_text;
                            color: #10b981;
                            font-size: 9px;
                            font-family: "Cascadia Mono";
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 28px;

                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: root.is_dark ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.08);
                        }

                        HorizontalLayout {
                            spacing: 2.5px;
                            HistBarCol { bar_h: root.live_bars[0]; is_dark: root.is_dark; hovered => { root.bar_hover(0); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[1]; is_dark: root.is_dark; hovered => { root.bar_hover(1); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[2]; is_dark: root.is_dark; hovered => { root.bar_hover(2); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[3]; is_dark: root.is_dark; hovered => { root.bar_hover(3); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[4]; is_dark: root.is_dark; hovered => { root.bar_hover(4); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[5]; is_dark: root.is_dark; hovered => { root.bar_hover(5); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[6]; is_dark: root.is_dark; hovered => { root.bar_hover(6); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[7]; is_dark: root.is_dark; hovered => { root.bar_hover(7); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[8]; is_dark: root.is_dark; hovered => { root.bar_hover(8); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[9]; is_dark: root.is_dark; hovered => { root.bar_hover(9); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[10]; is_dark: root.is_dark; hovered => { root.bar_hover(10); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[11]; is_dark: root.is_dark; hovered => { root.bar_hover(11); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[12]; is_dark: root.is_dark; hovered => { root.bar_hover(12); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[13]; is_dark: root.is_dark; hovered => { root.bar_hover(13); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[14]; is_dark: root.is_dark; hovered => { root.bar_hover(14); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[15]; is_dark: root.is_dark; hovered => { root.bar_hover(15); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[16]; is_dark: root.is_dark; hovered => { root.bar_hover(16); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[17]; is_dark: root.is_dark; hovered => { root.bar_hover(17); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[18]; is_dark: root.is_dark; hovered => { root.bar_hover(18); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[19]; is_dark: root.is_dark; hovered => { root.bar_hover(19); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[20]; is_dark: root.is_dark; hovered => { root.bar_hover(20); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[21]; is_dark: root.is_dark; hovered => { root.bar_hover(21); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[22]; is_dark: root.is_dark; hovered => { root.bar_hover(22); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[23]; is_dark: root.is_dark; hovered => { root.bar_hover(23); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[24]; is_dark: root.is_dark; hovered => { root.bar_hover(24); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[25]; is_dark: root.is_dark; hovered => { root.bar_hover(25); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[26]; is_dark: root.is_dark; hovered => { root.bar_hover(26); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[27]; is_dark: root.is_dark; hovered => { root.bar_hover(27); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[28]; is_dark: root.is_dark; hovered => { root.bar_hover(28); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[29]; is_dark: root.is_dark; hovered => { root.bar_hover(29); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[30]; is_dark: root.is_dark; hovered => { root.bar_hover(30); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_h: root.live_bars[31]; is_latest: true; is_dark: root.is_dark; hovered => { root.bar_hover(31); } unhovered => { root.bar_leave(); } }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        height: 10px;
                        Text { text: "-31"; font-size: 8px; font-family: "Cascadia Mono"; color: root.is_dark ? #64748b : #94a3b8; }
                        Text { text: "-20"; font-size: 8px; font-family: "Cascadia Mono"; color: root.is_dark ? #64748b : #94a3b8; }
                        Text { text: "-10"; font-size: 8px; font-family: "Cascadia Mono"; color: root.is_dark ? #64748b : #94a3b8; }
                        Text { text: "现"; font-size: 8px; font-family: "Cascadia Mono"; font-weight: 700; color: #10b981; }
                    }
                }
            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 67px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 3px;

                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    height: 14px;
                    Text {
                        text: "上下文用量";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.live_session_context_text;
                        color: root.ctx_used_pct >= 0.95 ? #c94f5e : (root.ctx_used_pct >= 0.8 ? #c9822f : (root.is_dark ? #cbd5e1 : #334155));
                        font-size: 11px;
                        font-weight: 600;
                        font-family: "Cascadia Mono";
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    height: 16px;

                    HorizontalLayout {
                        alignment: start;
                        spacing: 14px;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Text {
                                text: root.live_prompt_text;
                                color: root.is_dark ? #5fbde8 : #1c6f96;
                                font-size: 10px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 3px;
                                Text {
                                    text: root.live_cache_legend;
                                    color: root.is_dark ? #3dbd92 : #12684f;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "·";
                                    color: root.is_dark ? #2f8f70 : #1a7a5c;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.live_cache_hit_text;
                                    color: root.is_dark ? #2f8f70 : #1a7a5c;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.live_output_text;
                                color: root.is_dark ? #9aa1e8 : #474da0;
                                font-size: 10px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                bar_ctx := Rectangle {
                    height: 18px;
                    background: root.is_dark ? #334155 : #cbd5e1;
                    border-radius: 0;
                    clip: true;

                    Rectangle {
                        x: 0;
                        width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_prompt_pct));
                        height: 18px;
                        background: #45a8d8;
                    }
                    Rectangle {
                        x: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_prompt_pct));
                        width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_cache_pct));
                        height: 18px;
                        background: #2fa07d;
                    }
                    Rectangle {
                        x: bar_ctx.width * (Math.min(1.0, Math.max(0.0, root.live_prompt_pct)) + Math.min(1.0, Math.max(0.0, root.live_cache_pct)));
                        width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_output_pct));
                        height: 18px;
                        background: #8a91e0;
                    }

                    Rectangle {
                        x: 0;
                        width: bar_ctx.width * root.ctx_used_pct;
                        height: 18px;
                        background: root.ctx_used_pct >= 0.95 ? #c94f5e : (root.ctx_used_pct >= 0.8 ? #c9822f : transparent);
                    }

                    Rectangle {
                        x: bar_ctx.width * 0.8 - 0.5px;
                        width: 1px;
                        height: 18px;
                        background: root.is_dark ? rgba(248, 250, 252, 0.45) : rgba(15, 23, 42, 0.35);
                    }
                    Rectangle {
                        x: bar_ctx.width * 0.95 - 0.5px;
                        width: 1px;
                        height: 18px;
                        background: root.is_dark ? rgba(248, 250, 252, 0.45) : rgba(15, 23, 42, 0.35);
                    }
                }

            }
        }

        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 6px;
            height: 36px;
            HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            alignment: space-between;

                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 3.5px;
                        background: root.widget_mode == "smart" ? #10b981 : (root.widget_mode == "always" ? #38bdf8 : (root.is_dark ? #475569 : #94a3b8));
                        y: (parent.height - 7px) / 2;
                    }

                    Text {
                        text: "悬浮窗";
                        color: root.is_dark ? #f8fafc : #0f172a;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: end;
                    y: (parent.height - 24px) / 2;

                    Rectangle {
                        width: 52px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.widget_mode == "smart" ? (root.is_dark ? rgba(16, 185, 129, 0.22) : rgba(16, 185, 129, 0.15)) : (smart_ta.has-hover ? (root.is_dark ? #1e293b : #e2e8f0) : transparent);
                        border-color: root.widget_mode == "smart" ? #10b981 : (root.is_dark ? #1e293b : #cbd5e1);
                        border-width: 1px;

                        Text {
                            text: "自动";
                            color: root.widget_mode == "smart" ? #10b981 : (root.is_dark ? #94a3b8 : #64748b);
                            font-size: 10.5px;
                            font-weight: root.widget_mode == "smart" ? 700 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        smart_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set_widget_mode("smart"); }
                        }
                    }

                    Rectangle {
                        width: 52px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.widget_mode == "always" ? (root.is_dark ? rgba(56, 189, 248, 0.22) : rgba(56, 189, 248, 0.15)) : (always_ta.has-hover ? (root.is_dark ? #1e293b : #e2e8f0) : transparent);
                        border-color: root.widget_mode == "always" ? #38bdf8 : (root.is_dark ? #1e293b : #cbd5e1);
                        border-width: 1px;

                        Text {
                            text: "常驻";
                            color: root.widget_mode == "always" ? #38bdf8 : (root.is_dark ? #94a3b8 : #64748b);
                            font-size: 10.5px;
                            font-weight: root.widget_mode == "always" ? 700 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        always_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set_widget_mode("always"); }
                        }
                    }

                    Rectangle {
                        width: 52px;
                        height: 24px;
                        border-radius: 4px;
                        background: root.widget_mode == "hidden" ? (root.is_dark ? rgba(148, 163, 184, 0.2) : rgba(100, 116, 139, 0.12)) : (close_ta.has-hover ? (root.is_dark ? #1e293b : #e2e8f0) : transparent);
                        border-color: root.widget_mode == "hidden" ? #94a3b8 : (root.is_dark ? #1e293b : #cbd5e1);
                        border-width: 1px;

                        Text {
                            text: "关闭";
                            color: root.widget_mode == "hidden" ? (root.is_dark ? #cbd5e1 : #334155) : (root.is_dark ? #94a3b8 : #64748b);
                            font-size: 10.5px;
                            font-weight: root.widget_mode == "hidden" ? 700 : 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close_ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.set_widget_mode("hidden"); }
                        }
                    }
                }
            }
        }
    }
}
