                            HistBarCol { bar_ratio: root.live_bars[10]; is_dark: root.is_dark; hovered => { root.bar_hover(10); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[11]; is_dark: root.is_dark; hovered => { root.bar_hover(11); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[12]; is_dark: root.is_dark; hovered => { root.bar_hover(12); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[13]; is_dark: root.is_dark; hovered => { root.bar_hover(13); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[14]; is_dark: root.is_dark; hovered => { root.bar_hover(14); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[15]; is_dark: root.is_dark; hovered => { root.bar_hover(15); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[16]; is_dark: root.is_dark; hovered => { root.bar_hover(16); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[17]; is_dark: root.is_dark; hovered => { root.bar_hover(17); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[18]; is_dark: root.is_dark; hovered => { root.bar_hover(18); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[19]; is_dark: root.is_dark; hovered => { root.bar_hover(19); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[20]; is_dark: root.is_dark; hovered => { root.bar_hover(20); } unhovered => { root.bar_leave(); } }
