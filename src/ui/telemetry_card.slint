                            HistBarCol { bar_ratio: root.live_bars[23]; is_dark: root.is_dark; hovered => { root.bar_hover(23); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[24]; is_dark: root.is_dark; hovered => { root.bar_hover(24); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[25]; is_dark: root.is_dark; hovered => { root.bar_hover(25); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[26]; is_dark: root.is_dark; hovered => { root.bar_hover(26); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[27]; is_dark: root.is_dark; hovered => { root.bar_hover(27); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[28]; is_dark: root.is_dark; hovered => { root.bar_hover(28); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[29]; is_dark: root.is_dark; hovered => { root.bar_hover(29); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[30]; is_dark: root.is_dark; hovered => { root.bar_hover(30); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[31]; is_dark: root.is_dark; hovered => { root.bar_hover(31); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[32]; is_dark: root.is_dark; hovered => { root.bar_hover(32); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[33]; is_dark: root.is_dark; hovered => { root.bar_hover(33); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[34]; is_dark: root.is_dark; hovered => { root.bar_hover(34); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[35]; is_dark: root.is_dark; hovered => { root.bar_hover(35); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[36]; is_dark: root.is_dark; hovered => { root.bar_hover(36); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[37]; is_dark: root.is_dark; hovered => { root.bar_hover(37); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[38]; is_dark: root.is_dark; hovered => { root.bar_hover(38); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[39]; is_dark: root.is_dark; hovered => { root.bar_hover(39); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[40]; is_dark: root.is_dark; hovered => { root.bar_hover(40); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[41]; is_dark: root.is_dark; hovered => { root.bar_hover(41); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[42]; is_dark: root.is_dark; hovered => { root.bar_hover(42); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[43]; is_dark: root.is_dark; hovered => { root.bar_hover(43); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[44]; is_dark: root.is_dark; hovered => { root.bar_hover(44); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[45]; is_dark: root.is_dark; hovered => { root.bar_hover(45); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[46]; is_dark: root.is_dark; hovered => { root.bar_hover(46); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[47]; is_dark: root.is_dark; hovered => { root.bar_hover(47); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[48]; is_dark: root.is_dark; hovered => { root.bar_hover(48); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[49]; is_dark: root.is_dark; hovered => { root.bar_hover(49); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[50]; is_dark: root.is_dark; hovered => { root.bar_hover(50); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[51]; is_dark: root.is_dark; hovered => { root.bar_hover(51); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[52]; is_dark: root.is_dark; hovered => { root.bar_hover(52); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[53]; is_dark: root.is_dark; hovered => { root.bar_hover(53); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[54]; is_dark: root.is_dark; hovered => { root.bar_hover(54); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[55]; is_dark: root.is_dark; hovered => { root.bar_hover(55); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[56]; is_dark: root.is_dark; hovered => { root.bar_hover(56); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[57]; is_dark: root.is_dark; hovered => { root.bar_hover(57); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[58]; is_dark: root.is_dark; hovered => { root.bar_hover(58); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[59]; is_dark: root.is_dark; hovered => { root.bar_hover(59); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[60]; is_dark: root.is_dark; hovered => { root.bar_hover(60); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[61]; is_dark: root.is_dark; hovered => { root.bar_hover(61); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[62]; is_dark: root.is_dark; hovered => { root.bar_hover(62); } unhovered => { root.bar_leave(); } }
                            HistBarCol { bar_ratio: root.live_bars[63]; is_latest: true; is_dark: root.is_dark; hovered => { root.bar_hover(63); } unhovered => { root.bar_leave(); } }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        height: 15px;
                        Text { text: "-63"; font-size: 12px; font-family: "Cascadia Mono"; color: root.is_dark ? #64748b : #94a3b8; }
                        Text { text: "-40"; font-size: 12px; font-family: "Cascadia Mono"; color: root.is_dark ? #64748b : #94a3b8; }
                        Text { text: "-20"; font-size: 12px; font-family: "Cascadia Mono"; color: root.is_dark ? #64748b : #94a3b8; }
