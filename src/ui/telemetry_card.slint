        Rectangle {
            background: root.is_dark ? #090e1c : #f8fafc;
            border-color: root.is_dark ? #162032 : #e2e8f0;
            border-width: 1px;
            border-radius: 9px;
            height: 101px;
            VerticalLayout {
                padding-left: 15px;
                padding-right: 15px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 5px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 21px;
                    HorizontalLayout {
                        alignment: start;
                        spacing: 12px;
                        Text {
                            text: "上下文用量";
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 17px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.live_session_context_text;
                            color: root.ctx_used_pct >= 0.95 ? #c94f5e : (root.ctx_used_pct >= 0.8 ? #c9822f : (root.is_dark ? #cbd5e1 : #334155));
                            font-size: 17px;
                            font-weight: 600;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        text: root.live_compact_text;
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 15px;
                        font-family: "Cascadia Mono";
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    alignment: start;
                    height: 24px;

                    HorizontalLayout {
                        alignment: start;
                        spacing: 24px;

                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            Text {
                                text: root.live_prompt_text;
                                color: root.is_dark ? #5fbde8 : #1c6f96;
                                font-size: 15px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: start;
                                spacing: 5px;
                                Text {
                                    text: root.live_cache_legend;
                                    color: root.is_dark ? #3dbd92 : #12684f;
                                    font-size: 15px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "·";
                                    color: root.is_dark ? #2f8f70 : #1a7a5c;
                                    font-size: 15px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.live_cache_hit_text;
                                    color: root.is_dark ? #2f8f70 : #1a7a5c;
                                    font-size: 15px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.live_output_text;
                                color: root.is_dark ? #9aa1e8 : #474da0;
                                font-size: 15px;
                                font-family: "Cascadia Mono";
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                bar_ctx := Rectangle {
                    height: 27px;
                    background: root.is_dark ? #334155 : #cbd5e1;
                    border-radius: 6px;
                    clip: true;

                    Rectangle {
                        x: 0;
                        width: bar_ctx.width * root.ctx_prompt_w;
                        height: 27px;
                        background: #45a8d8;
                        border-top-left-radius: 6px;
                        border-bottom-left-radius: 6px;
                    }
                    Rectangle {
                        x: bar_ctx.width * root.ctx_prompt_w;
                        width: bar_ctx.width * root.ctx_cache_w;
                        height: 27px;
                        background: #2fa07d;
                        border-top-left-radius: root.ctx_prompt_w > 0 ? 0 : 6px;
                        border-bottom-left-radius: root.ctx_prompt_w > 0 ? 0 : 6px;
                    }
                    Rectangle {
                        x: bar_ctx.width * (root.ctx_prompt_w + root.ctx_cache_w);
                        width: bar_ctx.width * root.ctx_output_w;
                        height: 27px;
                        background: #8a91e0;
                        border-top-left-radius: (root.ctx_prompt_w + root.ctx_cache_w) > 0 ? 0 : 6px;
                        border-bottom-left-radius: (root.ctx_prompt_w + root.ctx_cache_w) > 0 ? 0 : 6px;
                    }

                    Rectangle {
                        x: 0;
                        width: bar_ctx.width * root.ctx_used_pct;
                        height: 27px;
                        background: root.ctx_used_pct >= 0.95 ? #c94f5e : (root.ctx_used_pct >= 0.8 ? #c9822f : transparent);
                        border-top-left-radius: 6px;
                        border-bottom-left-radius: 6px;
                    }

                    Rectangle {
                        x: bar_ctx.width * 0.8 - 0.5px;
                        width: 1px;
                        height: 27px;
                        background: root.is_dark ? rgba(248, 250, 252, 0.45) : rgba(15, 23, 42, 0.35);
                    }
                    Rectangle {
                        x: bar_ctx.width * 0.95 - 0.5px;
                        width: 1px;
                        height: 27px;
                        background: root.is_dark ? rgba(248, 250, 252, 0.45) : rgba(15, 23, 42, 0.35);
                    }
                }

            }
        }

        Rectangle { vertical-stretch: 1; }
    }
}
