import { CompactButton, OutlineButton } from "buttons.slint";
import { MiniMetricBox, UserProfileRow, SubQuotaCompactBox, SubScaleCacheRow, ModelQuotaRow } from "widgets.slint";
import { SessionUiItem } from "session_items.slint";

export component InstanceCard inherits Rectangle {
    in property <int> slot: 1;
    in property <string> title_text: "分身 1";
    in property <string> instance_id_text: "instance_1";
    in property <string> dir_button_text: "沙箱目录";
    in property <float> card_stretch: 1;
    in property <length> card_max_height: 150000px;
    in property <length> content_padding_bottom: 9px;
    in property <bool> content_fill: true;
    in property <bool> is_running: false;
    in property <string> pid_text: "--";
    in property <string> user_name: "--";
    in property <string> user_email: "--";
    in property <string> tier: "";
    in property <image> avatar;
    in property <bool> has_avatar: false;
    in property <string> port_text: "";
    in property <[ModelQuotaRow]> model_quotas: [];
    in property <bool> token_present: false;
    in property <string> session_count_text: "--";
    in property <string> recent_project: "暂无活动会话";
    in property <string> recent_title: "";
    in property <string> recent_tokens: "";
    in property <string> recent_time: "等待初始化";
    in property <bool> has_running_session: false;
    in property <bool> has_sessions: false;
    in property <[SessionUiItem]> session_items: [];
    in property <string> cache_size_text: "缓存 0 MB";
    in property <string> scale_text: "100%";
    in property <bool> is_dark: true;

    property <bool> show_menu: false;

    callback session_clicked();
    callback adjust_scale(int);
    callback reset_scale();
    callback launch();
    callback stop();
    callback clear_token();
    callback open_dir();

    horizontal-stretch: root.card_stretch;
    min-width: 0px;
    preferred-width: 0px;
    max-height: root.card_max_height;
    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_running ? rgba(16, 185, 129, 0.45) : (root.is_dark ? #162032 : #e2e8f0);
    border-width: 1px;
    border-radius: 12px;
    clip: true;

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: root.content_padding_bottom;
        spacing: 6px;

        HorizontalLayout {
            alignment: space-between;
            height: 30px;
            HorizontalLayout {
                spacing: 9px;
                alignment: start;

                Text {
                    text: root.title_text;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    background: root.is_running ? (root.is_dark ? rgba(16, 185, 129, 0.12) : rgba(16, 185, 129, 0.15)) : (root.is_dark ? rgba(100, 116, 139, 0.12) : rgba(148, 163, 184, 0.15));
                    border-color: root.is_running ? (root.is_dark ? rgba(16, 185, 129, 0.28) : rgba(16, 185, 129, 0.38)) : (root.is_dark ? rgba(100, 116, 139, 0.25) : rgba(148, 163, 184, 0.35));
                    border-width: 1px;
                    border-radius: 11px;
                    height: 22px;
                    y: (parent.height - 22px) / 2;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 5px;
                        alignment: center;

                        Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: root.is_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                            y: (parent.height - 7px) / 2;
                        }

                        Text {
                            text: root.is_running ? "运行中" : "未运行";
                            color: root.is_running ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: root.show_menu ? (root.is_dark ? #38bdf8 : #0284c7) : (menu_ta.has-hover ? (root.is_dark ? #334155 : #cbd5e1) : (root.is_dark ? #1e293b : #e2e8f0));
                    background: root.show_menu ? (root.is_dark ? rgba(56, 189, 248, 0.2) : rgba(56, 189, 248, 0.15)) : (menu_ta.has-hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #0d1527 : #f1f5f9));
                    y: (parent.height - 28px) / 2;

                    menu_ta := TouchArea {
                        clicked => { root.show_menu = !root.show_menu; }
                        mouse-cursor: pointer;
                    }

                    Text {
                        text: "···";
                        color: root.show_menu ? (root.is_dark ? #38bdf8 : #0284c7) : (menu_ta.has-hover ? (root.is_dark ? #f8fafc : #0f172a) : (root.is_dark ? #94a3b8 : #64748b));
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        UserProfileRow {
            user_name: root.user_name;
            user_email: root.user_email;
            tier: root.tier;
            avatar: root.avatar;
            has_avatar: root.has_avatar;
            port_text: root.port_text;
            is_dark: root.is_dark;
        }

        SubQuotaCompactBox {
            model_quotas: root.model_quotas;
            is_dark: root.is_dark;
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 80px;
            background: root.is_dark ? #0d1527 : #ffffff;
            border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
            border-width: 1px;
            border-radius: 9px;

            tele_ta := TouchArea {
                mouse-cursor: root.has_sessions ? pointer : default;
                clicked => {
                    if root.has_sessions {
                        root.session_clicked();
                    }
                }
            }

            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 6px;
                alignment: space-between;

                HorizontalLayout {
                    height: 20px;
                    alignment: space-between;

                    Text {
                        text: "活动遥测";
                        color: root.is_dark ? #94a3b8 : #64748b;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        if root.is_running && root.pid_text != "--" : Text {
                            text: "PID " + root.pid_text;
                            color: root.is_dark ? #34d399 : #059669;
                            font-size: 13px;
                            font-weight: 600;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.session_count_text != "--" ? "会话 " + root.session_count_text : (root.is_running ? "会话 0 项" : "--");
                            color: root.has_running_session ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                            font-size: 13px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: space-between;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.recent_project != "" && root.recent_project != "无活动会话" ? root.recent_project : (root.slot == 0 ? "主机主控" : root.instance_id_text);
                            color: root.recent_project != "" && root.recent_project != "无活动会话" ? (root.is_dark ? #f8fafc : #0f172a) : (root.is_dark ? #64748b : #94a3b8);
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.recent_title != "" ? root.recent_title : (root.is_running ? "沙箱运行中" : "--");
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 12px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                    }

                    if root.recent_tokens != "" : VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.recent_tokens;
                            color: root.is_dark ? #38bdf8 : #0284c7;
                            font-size: 13px;
                            font-weight: 600;
                            font-family: "Cascadia Mono";
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.recent_time;
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        VerticalLayout {
            spacing: 6px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 9px;
                height: 48px;
                if !root.is_running : CompactButton {
                    horizontal-stretch: 1;
                    text: "启动";
                    btn_color: #10b981;
                    is_dark: root.is_dark;
                    clicked => { root.launch(); }
                }
                if root.is_running : CompactButton {
                    horizontal-stretch: 1;
                    text: "停止";
                    btn_color: #f43f5e;
                    is_dark: root.is_dark;
                    clicked => { root.stop(); }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                height: 24px;
                Text {
                    text: root.cache_size_text;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Text {
                    text: root.scale_text;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 13px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }


    }

    if root.show_menu : Rectangle {
        background: root.is_dark ? #0d1527 : #ffffff;
        border-color: root.is_dark ? #334155 : #cbd5e1;
        border-width: 1px;
        border-radius: 12px;
        x: 6px;
        y: 42px;
        width: parent.width - 12px;
        height: parent.height - 48px;

        VerticalLayout {
            padding: 12px;
            spacing: 9px;

            HorizontalLayout {
                alignment: space-between;
                height: 27px;
                Text {
                    text: "维护设置";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 27px;
                    height: 27px;
                    border-radius: 5px;
                    background: close_menu_ta.has-hover ? (root.is_dark ? #334155 : #cbd5e1) : transparent;
                    close_menu_ta := TouchArea {
                        clicked => { root.show_menu = false; }
                        mouse-cursor: pointer;
                    }
                    Text {
                        text: "×";
                        color: root.is_dark ? #cbd5e1 : #475569;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: root.is_dark ? #1e293b : #e2e8f0;
            }

            SubScaleCacheRow {
                cache_text: root.cache_size_text;
                scale_text: root.scale_text;
                is_dark: root.is_dark;
                dec_clicked => { root.adjust_scale(-10); }
                inc_clicked => { root.adjust_scale(10); }
                reset_clicked => { root.reset_scale(); }
            }

            HorizontalLayout {
                spacing: 9px;
                height: 39px;
                OutlineButton {
                    horizontal-stretch: 1;
                    text: "清理凭据";
                    is_dark: root.is_dark;
                    is_disabled: root.is_running || !root.token_present;
                    clicked => {
                        root.show_menu = false;
                        root.clear_token();
                    }
                }
                OutlineButton {
                    horizontal-stretch: 1;
                    text: root.dir_button_text;
                    is_dark: root.is_dark;
                    clicked => {
                        root.show_menu = false;
                        root.open_dir();
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }
}
