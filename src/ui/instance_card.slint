import { CompactButton, OutlineButton } from "buttons.slint";
import { MiniMetricBox, UserProfileRow, SubQuotaCompactBox, SubScaleCacheRow } from "widgets.slint";
import { SubSessionCardBox } from "session_items.slint";

export component SubInstanceCard inherits Rectangle {
    in property <int> slot: 1;
    in property <string> title_text: "分身 1";
    in property <string> instance_id_text: "instance_1";
    in property <bool> is_running: false;
    in property <string> pid_text: "--";
    in property <string> user_name: "--";
    in property <string> user_email: "--";
    in property <string> tier: "";
    in property <image> avatar;
    in property <bool> has_avatar: false;
    in property <string> port_text: "";
    in property <string> weekly_reset: "";
    in property <string> weekly_pct: "--";
    in property <image> weekly_ring;
    in property <string> five_h_reset: "";
    in property <string> five_h_pct: "--";
    in property <image> five_h_ring;
    in property <bool> quota_refreshing: false;
    in property <bool> token_present: false;
    in property <angle> spin_angle: 0deg;
    in property <string> cpu_text: "--";
    in property <string> ram_text: "--";
    in property <string> session_count_text: "--";
    in property <string> recent_project: "暂无活动会话";
    in property <string> recent_title: "";
    in property <string> recent_tokens: "";
    in property <string> recent_time: "等待初始化";
    in property <bool> has_running_session: false;
    in property <bool> has_sessions: false;
    in property <string> cache_size_text: "缓存 0 MB";
    in property <string> scale_text: "100%";
    in property <bool> is_dark: true;

    callback refresh_quota();
    callback session_clicked();
    callback adjust_scale(int);
    callback reset_scale();
    callback launch();
    callback stop();
    callback clear_token();
    callback open_sandbox();

    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_running ? rgba(16, 185, 129, 0.45) : (root.is_dark ? #162032 : #e2e8f0);
    border-width: 1px;
    border-radius: 8px;
    clip: true;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 3px;

        HorizontalLayout {
            alignment: space-between;
            height: 20px;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.is_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                    y: (parent.height - 7px) / 2;
                }
                Text {
                    text: root.title_text;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {
                    background: root.is_running ? (root.is_dark ? rgba(16, 185, 129, 0.1) : rgba(16, 185, 129, 0.12)) : (root.is_dark ? #0d1527 : #e2e8f0);
                    border-color: root.is_running ? (root.is_dark ? rgba(16, 185, 129, 0.3) : rgba(16, 185, 129, 0.4)) : (root.is_dark ? #1e293b : #cbd5e1);
                    border-width: 1px;
                    border-radius: 3px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        alignment: center;
                        Text {
                            text: root.instance_id_text;
                            color: root.is_running ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                            font-size: 10px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if root.is_running : Rectangle {
                background: root.is_dark ? rgba(16, 185, 129, 0.12) : rgba(16, 185, 129, 0.15);
                border-color: root.is_dark ? rgba(16, 185, 129, 0.35) : rgba(16, 185, 129, 0.45);
                border-width: 1px;
                border-radius: 4px;
                height: 18px;
                y: (parent.height - 18px) / 2;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: "PID " + root.pid_text;
                        color: root.is_dark ? #34d399 : #059669;
                        font-size: 10.5px;
                        font-family: "Cascadia Mono";
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
            if !root.is_running : Text {
                text: "未运行";
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 10.5px;
                font-family: "Cascadia Mono";
                vertical-alignment: center;
            }
        }

        UserProfileRow {
            user_name: root.user_name;
            user_email: root.user_email;
            tier: root.tier;
            avatar: root.avatar;
            has_avatar: root.has_avatar;
            port_text: root.port_text;
            is_dark: root.is_dark;
        }

        SubQuotaCompactBox {
            weekly_reset: root.weekly_reset;
            weekly_pct: root.weekly_pct;
            weekly_ring: root.weekly_ring;
            five_h_reset: root.five_h_reset;
            five_h_pct: root.five_h_pct;
            five_h_ring: root.five_h_ring;
            is_dark: root.is_dark;
            is_refreshing: root.quota_refreshing;
            is_refresh_disabled: !root.token_present;
            spin_angle: root.spin_angle;
            refresh_clicked => { root.refresh_quota(); }
        }

        HorizontalLayout {
            spacing: 6px;
            MiniMetricBox { horizontal-stretch: 1; label: "CPU"; val_text: root.cpu_text; val_color: root.is_running ? #34d399 : transparent; is_dark: root.is_dark; }
            MiniMetricBox { horizontal-stretch: 1; label: "内存"; val_text: root.ram_text; val_color: root.is_running ? #38bdf8 : transparent; is_dark: root.is_dark; }
            MiniMetricBox { horizontal-stretch: 1; label: "会话总数"; val_text: root.session_count_text; is_dark: root.is_dark; }
        }

        SubSessionCardBox {
            project_name: root.recent_project;
            session_title: root.recent_title;
            tokens_text: root.recent_tokens;
            time_text: root.recent_time;
            is_running: root.is_running || root.has_running_session;
            has_sessions: root.has_sessions;
            is_dark: root.is_dark;
            clicked => { root.session_clicked(); }
        }

        VerticalLayout {
            spacing: 3px;
            vertical-stretch: 0;

            SubScaleCacheRow {
                cache_text: root.cache_size_text;
                scale_text: root.scale_text;
                is_dark: root.is_dark;
                dec_clicked => { root.adjust_scale(-10); }
                inc_clicked => { root.adjust_scale(10); }
                reset_clicked => { root.reset_scale(); }
            }

            HorizontalLayout {
                spacing: 6px;
                height: 28px;
                if !root.is_running : CompactButton {
                    horizontal-stretch: 1;
                    text: "启动";
                    btn_color: #10b981;
                    is_dark: root.is_dark;
                    clicked => { root.launch(); }
                }
                if root.is_running : CompactButton {
                    horizontal-stretch: 1;
                    text: "打开";
                    btn_color: #38bdf8;
                    is_dark: root.is_dark;
                    clicked => { root.launch(); }
                }
                if root.is_running : CompactButton {
                    horizontal-stretch: 1;
                    text: "停止";
                    btn_color: #f43f5e;
                    is_dark: root.is_dark;
                    clicked => { root.stop(); }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                height: 26px;
                OutlineButton {
                    horizontal-stretch: 1;
                    text: "清理凭据";
                    is_dark: root.is_dark;
                    is_disabled: root.is_running || !root.token_present;
                    clicked => { root.clear_token(); }
                }
                OutlineButton {
                    horizontal-stretch: 1;
                    text: "打开目录";
                    is_dark: root.is_dark;
                    clicked => { root.open_sandbox(); }
                }
            }
        }
    }
}
