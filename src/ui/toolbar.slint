import { OutlineButton } from "buttons.slint";

export component StatusToolbar inherits Rectangle {
    in property <bool> is_dark: true;
    in property <bool> sound_on: true;

    callback preview_sound();
    callback toggle_sound();

    height: 36px;
    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 8px;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;

        HorizontalLayout {
            height: 26px;
            spacing: 8px;
            alignment: start;

            OutlineButton {
                width: 76px;
                btn_height: 26px;
                text: root.sound_on ? "音效: 开" : "音效: 关";
                hover_color: root.sound_on ? #38bdf8 : #64748b;
                is_dark: root.is_dark;
                clicked => { root.toggle_sound(); }
            }

            OutlineButton {
                width: 56px;
                btn_height: 26px;
                text: "试听";
                is_dark: root.is_dark;
                is_disabled: !root.sound_on;
                clicked => { root.preview_sound(); }
            }
        }
    }
}
