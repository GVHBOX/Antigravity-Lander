import { OutlineButton } from "buttons.slint";

export component StatusToolbar inherits Rectangle {
    in property <bool> is_dark: true;
    in property <bool> sound_on: true;
    in property <string> global_summary_text: "";
    in property <string> proxy_badge_text: "";
    in property <string> sub_running_count_text: "";

    callback preview_sound();
    callback toggle_sound();

    height: 54px;
    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 12px;

    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: center;

        HorizontalLayout {
            height: 39px;
            spacing: 15px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                OutlineButton {
                    width: 114px;
                    btn_height: 39px;
                    text: root.sound_on ? "音效: 开" : "音效: 关";
                    hover_color: root.sound_on ? #38bdf8 : #64748b;
                    is_dark: root.is_dark;
                    clicked => { root.toggle_sound(); }
                }

                OutlineButton {
                    width: 84px;
                    btn_height: 39px;
                    text: "试听";
                    is_dark: root.is_dark;
                    is_disabled: !root.sound_on;
                    clicked => { root.preview_sound(); }
                }
            }

            HorizontalLayout {
                spacing: 21px;
                alignment: end;

                Text {
                    text: root.global_summary_text;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 17px;
                    font-family: "Cascadia Mono";
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    text: root.sub_running_count_text;
                    color: root.is_dark ? #34d399 : #059669;
                    font-size: 17px;
                    font-family: "Cascadia Mono";
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Text {
                    text: root.proxy_badge_text;
                    color: root.is_dark ? #5fbde8 : #1c6f96;
                    font-size: 17px;
                    font-family: "Cascadia Mono";
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}
