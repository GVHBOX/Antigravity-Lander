import { PatchItemRow } from "widgets.slint";

export component ComponentsCard inherits Rectangle {
    in property <bool> patch_ag2_installed: false;
    in property <string> patch_ag2_version: "未安装";
    in property <bool> proxy_injected: false;
    in property <string> proxy_status_text: "未启用";
    in property <string> cache_summary_text: "无缓存占用";
    in property <bool> is_dark: true;

    callback toggle_patch_ag2();
    callback toggle_proxy();
    callback scan_cache();

    horizontal-stretch: 3;
    min-width: 0px;
    preferred-width: 0px;
    max-height: 150000px;
    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
    border-width: 1px;
    border-radius: 15px;
    clip: true;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        HorizontalLayout {
            height: 36px;
            Text {
                text: "内置组件";
                color: root.is_dark ? #f8fafc : #0f172a;
                font-size: 21px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        PatchItemRow {
            title: "Antigravity 桌面版汉化补丁";
            status_text: root.patch_ag2_installed ? ("已汉化 (" + root.patch_ag2_version + ")") : (root.patch_ag2_version == "未安装" ? "未安装" : ("未汉化 (" + root.patch_ag2_version + ")"));
            is_installed: root.patch_ag2_installed;
            btn_text: root.patch_ag2_installed ? "卸载" : "安装";
            btn_tone: root.patch_ag2_installed ? "danger" : "positive";
            is_dark: root.is_dark;
            btn_clicked => { root.toggle_patch_ag2(); }
        }

        PatchItemRow {
            title: "系统代理补丁";
            status_text: root.proxy_status_text;
            is_installed: root.proxy_injected;
            btn_text: root.proxy_injected ? "移除" : "注入";
            btn_tone: root.proxy_injected ? "danger" : "positive";
            is_dark: root.is_dark;
            btn_clicked => { root.toggle_proxy(); }
        }

        PatchItemRow {
            title: "存储管理";
            status_text: root.cache_summary_text;
            is_installed: false;
            btn_text: "清理";
            btn_tone: "neutral";
            is_dark: root.is_dark;
            btn_clicked => { root.scan_cache(); }
        }
    }
}
