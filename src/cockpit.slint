import { ScrollView } from "std-widgets.slint";

export struct SessionUiItem {
    is_group_header: bool,
    group_name: string,
    group_count_str: string,
    group_has_running: bool,
    id: string,
    title: string,
    context_str: string,
    cache_rate_str: string,
    time_ago_str: string,
    is_running: bool,
}
component FolderIcon inherits Path {
    in property <color> icon_color: #38bdf8;
    width: 13px;
    height: 11px;
    commands: "M 1 2 L 4.5 2 L 6 3.5 L 12 3.5 C 12.5 3.5 13 4 13 4.5 L 13 9.5 C 13 10 12.5 10.5 12 10.5 L 1 10.5 C 0.5 10.5 0 10 0 9.5 L 0 3 C 0 2.5 0.5 2 1 2 Z";
    stroke: root.icon_color;
    stroke-width: 1.1px;
    fill: transparent;
}

component PinIcon inherits Path {
    in property <color> icon_color: #64748b;
    width: 12px;
    height: 12px;
    commands: "M 2.5 2 L 9.5 2 M 3.5 2 L 3.5 5 L 2 7 L 10 7 L 8.5 5 L 8.5 2 M 6 7 L 6 11.5";
    stroke: root.icon_color;
    stroke-width: 1.2px;
}

component SunIcon inherits Path {
    in property <color> icon_color: #f8fafc;
    width: 13px;
    height: 13px;
    commands: "M 6.5 4 A 2.5 2.5 0 1 0 6.5 9 A 2.5 2.5 0 1 0 6.5 4 M 6.5 1 L 6.5 2.5 M 6.5 10.5 L 6.5 12 M 1 6.5 L 2.5 6.5 M 10.5 6.5 L 12 6.5 M 2.6 2.6 L 3.7 3.7 M 9.3 9.3 L 10.4 10.4 M 2.6 10.4 L 3.7 9.3 M 9.3 3.7 L 10.4 2.6";
    stroke: root.icon_color;
    stroke-width: 1.1px;
}

component MoonIcon inherits Path {
    in property <color> icon_color: #0f172a;
    width: 13px;
    height: 13px;
    commands: "M 10 8 A 4.2 4.2 0 1 1 4.5 2 A 3.5 3.5 0 0 0 10 8 Z";
    stroke: root.icon_color;
    stroke-width: 1.1px;
    fill: transparent;
}

component SessionSummaryRow inherits Rectangle {
    in property <string> summary_text: "无活动会话";
    in property <bool> is_running: false;
    in property <bool> has_sessions: false;
    in property <bool> is_dark: true;
    callback clicked();

    background: ta.has_hover ? (root.is_dark ? #131c2b : #f1f5f9) : (root.is_dark ? #090e1c : #f8fafc);
    border-color: ta.has_hover ? #38bdf8 : (root.is_dark ? #162032 : #e2e8f0);
    border-width: 1px;
    border-radius: 6px;
    height: 32px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.is_running ? #10b981 : (root.has_sessions ? #38bdf8 : (root.is_dark ? #475569 : #94a3b8));
                y: (parent.height - 8px) / 2;
            }

            Text {
                text: root.summary_text;
                color: root.has_sessions ? (root.is_dark ? #f8fafc : #0f172a) : (root.is_dark ? #64748b : #94a3b8);
                font-size: 12.5px;
                font-family: "Cascadia Mono";
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Text {
            text: "明细 >";
            color: ta.has_hover ? #38bdf8 : (root.is_dark ? #64748b : #94a3b8);
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component SessionGroupHeader inherits Rectangle {
    in property <string> group_name;
    in property <string> count_str;
    in property <bool> has_running: false;
    in property <bool> is_dark: true;

    height: 38px;
    background: root.is_dark ? #18191d : #f1f5f9;
    border-color: root.is_dark ? #2a2d36 : #cbd5e1;
    border-width: 1px;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 4px;
                height: 16px;
                border-radius: 2px;
                background: #38bdf8;
                y: (parent.height - 16px) / 2;
            }

            Text {
                text: root.group_name;
                color: root.is_dark ? #f8fafc : #0f172a;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.has_running : Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: #10b981;
                y: (parent.height - 7px) / 2;
            }
        }

        Text {
            text: root.count_str;
            color: root.is_dark ? #94a3b8 : #64748b;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component SessionModalRow inherits Rectangle {
    in property <SessionUiItem> item;
    in property <bool> is_dark: true;

    background: root.is_dark ? #222225 : #f8fafc;
    border-color: root.item.is_running ? rgba(16, 185, 129, 0.45) : (root.is_dark ? #33373e : #e2e8f0);
    border-width: 1px;
    border-radius: 6px;
    height: 58px;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            horizontal-stretch: 1;

            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.item.is_running ? #10b981 : (root.is_dark ? #525866 : #94a3b8);
                y: (parent.height - 10px) / 2;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: root.item.title;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: root.item.id;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 12px;
                    font-family: "Cascadia Mono";
                    overflow: elide;
                }
            }
        }

        HorizontalLayout {
            spacing: 22px;
            alignment: end;

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                min-width: 100px;

                Text {
                    text: "上下文";
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 11.5px;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.item.context_str;
                    color: root.is_dark ? #38bdf8 : #0284c7;
                    font-size: 15px;
                    font-weight: 700;
                    font-family: "Cascadia Mono";
                    horizontal-alignment: right;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                min-width: 90px;

                Text {
                    text: "缓存率";
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 11.5px;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.item.cache_rate_str;
                    color: root.is_dark ? #34d399 : #059669;
                    font-size: 15px;
                    font-weight: 700;
                    font-family: "Cascadia Mono";
                    horizontal-alignment: right;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;
                min-width: 85px;

                Text {
                    text: "更新";
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 11.5px;
                    horizontal-alignment: right;
                }
                Text {
                    text: root.item.time_ago_str;
                    color: root.is_dark ? #cbd5e1 : #64748b;
                    font-size: 12.5px;
                    font-family: "Cascadia Mono";
                    horizontal-alignment: right;
                }
            }
        }
    }
}

component CompactButton inherits Rectangle {
    in property <string> text;
    in property <color> btn_color: #38bdf8;
    in property <color> text_color: #070a13;
    in property <bool> is_dark: true;
    in property <bool> is_disabled: false;
    in property <length> btn_height: 28px;
    callback clicked();

    background: is_disabled ? (root.is_dark ? #111827 : #e2e8f0) : (ta.pressed ? btn_color.darker(15%) : (ta.has_hover ? btn_color.brighter(10%) : btn_color));
    border-color: is_disabled ? (root.is_dark ? #1f2937 : #cbd5e1) : (ta.has_hover ? btn_color.brighter(20%) : btn_color);
    border-width: 1px;
    border-radius: 6px;
    height: root.btn_height;

    ta := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.is_disabled ? default : pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            color: root.is_disabled ? (root.is_dark ? #4b5563 : #94a3b8) : root.text_color;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <color> hover_color: #38bdf8;
    in property <bool> is_dark: true;
    in property <bool> is_disabled: false;
    in property <length> btn_height: 26px;
    callback clicked();

    background: is_disabled ? (root.is_dark ? #090e1c : #f8fafc) : (ta.pressed ? (root.is_dark ? #1e293b : #e2e8f0) : (ta.has_hover ? (root.is_dark ? #131c2b : #f1f5f9) : (root.is_dark ? #090e1c : #f8fafc)));
    border-color: is_disabled ? (root.is_dark ? #162032 : #e2e8f0) : (ta.has_hover ? hover_color : (root.is_dark ? #1e293b : #cbd5e1));
    border-width: 1px;
    border-radius: 5px;
    height: root.btn_height;

    ta := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.is_disabled ? default : pointer;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.is_disabled ? (root.is_dark ? #475569 : #94a3b8) : (ta.has_hover ? hover_color : (root.is_dark ? #94a3b8 : #475569));
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component StepButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_dark: true;
    callback clicked();

    background: ta.pressed ? (root.is_dark ? #1e293b : #cbd5e1) : (ta.has_hover ? (root.is_dark ? #162238 : #e2e8f0) : (root.is_dark ? #0d1527 : #f1f5f9));
    border-color: ta.has_hover ? #38bdf8 : (root.is_dark ? #1e293b : #cbd5e1);
    border-width: 1px;
    border-radius: 5px;
    width: 26px;
    height: 26px;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    Text {
        text: root.text;
        color: ta.has_hover ? #38bdf8 : (root.is_dark ? #f8fafc : #0f172a);
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component ScaleControl inherits HorizontalLayout {
    in property <string> scale_text: "100%";
    in property <string> cache_text: "";
    in property <bool> is_dark: true;
    callback dec_clicked();
    callback inc_clicked();
    callback reset_clicked();

    alignment: space-between;
    height: 28px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        if root.cache_text != "" : Text {
            text: root.cache_text;
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 11px;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
        }
        Text {
            text: "界面调节";
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 11.5px;
            vertical-alignment: center;
        }
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: end;

        StepButton {
            text: "-";
            is_dark: root.is_dark;
            clicked => { root.dec_clicked(); }
        }

        Rectangle {
            width: 52px;
            height: 26px;
            background: root.is_dark ? #0d1527 : #ffffff;
            border-color: root.is_dark ? #1e293b : #cbd5e1;
            border-width: 1px;
            border-radius: 5px;

            TouchArea {
                clicked => { root.reset_clicked(); }
                mouse-cursor: pointer;
            }

            Text {
                text: root.scale_text;
                color: root.is_dark ? #38bdf8 : #0284c7;
                font-size: 12px;
                font-family: "Cascadia Mono";
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        StepButton {
            text: "+";
            is_dark: root.is_dark;
            clicked => { root.inc_clicked(); }
        }
    }
}

component MiniMetricBox inherits Rectangle {
    in property <string> label;
    in property <string> val_text;
    in property <color> val_color: transparent;
    in property <bool> is_dark: true;

    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
    border-width: 1px;
    border-radius: 5px;
    height: 36px;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: root.label;
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 10px;
            font-family: "Cascadia Mono";
            horizontal-alignment: center;
        }

        Text {
            text: root.val_text;
            color: root.val_color != transparent ? root.val_color : (root.val_text == "--" ? (root.is_dark ? #475569 : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a));
            font-size: 12px;
            font-weight: 700;
            font-family: "Cascadia Mono";
            horizontal-alignment: center;
        }
    }
}

component PatchItemRow inherits Rectangle {
    in property <string> title;
    in property <string> status_text;
    in property <bool> is_installed: false;
    in property <string> btn_text;
    in property <bool> is_dark: true;
    callback btn_clicked();

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 46px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: root.is_dark ? #f8fafc : #0f172a;
                font-size: 13px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 5px;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.is_installed ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                    y: (parent.height - 6px) / 2;
                }
                Text {
                    text: root.status_text;
                    color: root.is_installed ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                    font-size: 11px;
                    font-family: "Cascadia Mono";
                }
            }
        }

        Rectangle {
            width: 60px;
            height: 28px;
            y: (parent.height - 28px) / 2;
            background: root.is_installed ? (ta.has_hover ? #f43f5e : rgba(244, 63, 94, 0.15)) : (ta.has_hover ? #34d399 : #10b981);
            border-color: root.is_installed ? #f43f5e : #10b981;
            border-width: 1px;
            border-radius: 5px;

            ta := TouchArea {
                clicked => { root.btn_clicked(); }
                mouse-cursor: pointer;
            }

            Text {
                text: root.btn_text;
                color: root.is_installed ? (ta.has_hover ? #ffffff : #f43f5e) : #ffffff;
                font-size: 11.5px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

component UserProfileRow inherits Rectangle {
    in property <string> user_name: "--";
    in property <string> user_email: "--";
    in property <string> tier: "";
    in property <image> avatar;
    in property <bool> has_avatar: false;
    in property <string> port_text: "";
    in property <bool> is_dark: true;

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 38px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 9px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 9px;
            alignment: start;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                clip: true;
                background: root.is_dark ? #141c2b : #e2e8f0;
                y: (parent.height - 32px) / 2;

                if root.has_avatar : Image {
                    source: root.avatar;
                    width: 100%;
                    height: 100%;
                }
                if !root.has_avatar : Text {
                    text: root.user_name != "" && root.user_name != "--" ? "ID" : "--";
                    font-size: 11px;
                    color: root.is_dark ? #64748b : #94a3b8;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1px;

                HorizontalLayout {
                    spacing: 5px;
                    alignment: start;

                    Text {
                        text: root.user_name == "--" ? "未登录账号" : root.user_name;
                        color: root.user_name == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a);
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    if root.tier != "" : Rectangle {
                        background: root.is_dark ? rgba(16, 185, 129, 0.15) : rgba(16, 185, 129, 0.18);
                        border-color: root.is_dark ? rgba(16, 185, 129, 0.3) : rgba(16, 185, 129, 0.4);
                        border-width: 1px;
                        border-radius: 3px;
                        height: 16px;
                        y: (parent.height - 16px) / 2;

                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            alignment: center;
                            Text {
                                text: root.tier;
                                color: root.is_dark ? #34d399 : #059669;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.user_name == "--" ? "首次启动自动派生沙箱" : root.user_email;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 11px;
                    font-family: root.user_name == "--" ? "" : "Cascadia Mono";
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: root.port_text != "" ? (":" + root.port_text) : ":--";
            color: root.port_text != "" ? (root.is_dark ? #38bdf8 : #0284c7) : (root.is_dark ? #64748b : #94a3b8);
            font-size: 11.5px;
            font-family: "Cascadia Mono";
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

component QuotaNativeBox inherits Rectangle {
    in property <string> weekly_title: "每周限额剩余";
    in property <string> weekly_reset: "";
    in property <string> weekly_pct: "--";
    in property <image> weekly_ring;
    in property <string> five_h_title: "5 小时限额剩余";
    in property <string> five_h_reset: "";
    in property <string> daily_reset: "";
    in property <string> five_h_pct: "--";
    in property <image> five_h_ring;
    in property <bool> is_dark: true;

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 58px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 2px;
        alignment: space-around;

        HorizontalLayout {
            alignment: space-between;
            height: 24px;

            VerticalLayout {
                alignment: center;
                spacing: 0px;
                Text {
                    text: root.weekly_title;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 11.5px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                if root.weekly_reset != "" : Text {
                    text: root.weekly_reset;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 7px;
                alignment: end;
                Text {
                    text: root.weekly_pct;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 13px;
                    font-family: "Cascadia Mono";
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Image {
                    source: root.weekly_ring;
                    width: 20px;
                    height: 20px;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            height: 24px;

            VerticalLayout {
                alignment: center;
                spacing: 0px;
                Text {
                    text: root.five_h_title;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 11.5px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                if root.five_h_reset != "" : Text {
                    text: root.five_h_reset;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 7px;
                alignment: end;
                Text {
                    text: root.five_h_pct;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 13px;
                    font-family: "Cascadia Mono";
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Image {
                    source: root.five_h_ring;
                    width: 20px;
                    height: 20px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component SubQuotaCompactBox inherits Rectangle {
    in property <string> weekly_reset: "";
    in property <string> weekly_pct: "--";
    in property <image> weekly_ring;
    in property <string> five_h_reset: "";
    in property <string> five_h_pct: "--";
    in property <image> five_h_ring;
    in property <bool> is_dark: true;

    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 46px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        HorizontalLayout {
            alignment: space-between;
            height: 18px;

            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text {
                    text: "每周限额";
                    color: root.weekly_pct == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #cbd5e1 : #334155);
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if root.weekly_reset != "" : Text {
                    text: root.weekly_reset;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                if root.weekly_reset == "" && root.weekly_pct == "--" : Text {
                    text: "等待同步";
                    color: root.is_dark ? #334155 : #cbd5e1;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Text {
                    text: root.weekly_pct;
                    color: root.weekly_pct == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a);
                    font-size: 11.5px;
                    font-family: "Cascadia Mono";
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Image {
                    source: root.weekly_ring;
                    width: 16px;
                    height: 16px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            background: root.is_dark ? rgba(255, 255, 255, 0.05) : #e2e8f0;
        }

        HorizontalLayout {
            alignment: space-between;
            height: 18px;

            HorizontalLayout {
                spacing: 5px;
                alignment: start;
                Text {
                    text: "5小时限额";
                    color: root.five_h_pct == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #cbd5e1 : #334155);
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if root.five_h_reset != "" : Text {
                    text: root.five_h_reset;
                    color: root.is_dark ? #64748b : #94a3b8;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                if root.five_h_reset == "" && root.five_h_pct == "--" : Text {
                    text: "等待同步";
                    color: root.is_dark ? #334155 : #cbd5e1;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Text {
                    text: root.five_h_pct;
                    color: root.five_h_pct == "--" ? (root.is_dark ? #64748b : #94a3b8) : (root.is_dark ? #f8fafc : #0f172a);
                    font-size: 11.5px;
                    font-family: "Cascadia Mono";
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Image {
                    source: root.five_h_ring;
                    width: 16px;
                    height: 16px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component SubSessionCardBox inherits Rectangle {
    in property <string> project_name: "暂无活动会话";
    in property <string> session_title: "";
    in property <string> tokens_text: "";
    in property <string> time_text: "等待初始化";
    in property <bool> is_running: false;
    in property <bool> has_sessions: false;
    in property <bool> is_dark: true;
    callback clicked();

    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 60px;

    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        HorizontalLayout {
            alignment: space-between;
            height: 16px;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                FolderIcon {
                    icon_color: root.has_sessions ? (root.is_dark ? #38bdf8 : #0284c7) : (root.is_dark ? #64748b : #94a3b8);
                    y: (parent.height - 11px) / 2;
                }
                Text {
                    text: root.has_sessions ? root.project_name : "暂无活动会话";
                    color: root.has_sessions ? (root.is_dark ? #e2e8f0 : #1e293b) : (root.is_dark ? #64748b : #94a3b8);
                    font-size: 11.5px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.has_sessions ? (root.tokens_text != "" ? root.tokens_text : "--") : "0 会话";
                color: root.has_sessions ? #38bdf8 : (root.is_dark ? #64748b : #94a3b8);
                font-size: 10.5px;
                font-family: "Cascadia Mono";
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            height: 16px;
            alignment: start;
            Text {
                text: root.has_sessions ? (root.session_title != "" ? root.session_title : "标准会话") : "等待沙箱任务调度";
                color: root.has_sessions ? (root.is_dark ? #94a3b8 : #64748b) : (root.is_dark ? #475569 : #94a3b8);
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            alignment: space-between;
            height: 16px;

            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                if root.is_running : Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: #10b981;
                    y: (parent.height - 6px) / 2;
                }
                Text {
                    text: root.is_running ? "运行中 (刚刚刷新)" : (root.has_sessions ? root.time_text : "就绪 (未分配)");
                    color: root.is_running ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                    font-size: 10.5px;
                    font-family: "Cascadia Mono";
                    vertical-alignment: center;
                }
            }

            Rectangle {
                detail_ta := TouchArea {
                    clicked => {
                        if root.has_sessions {
                            root.clicked();
                        }
                    }
                    mouse-cursor: root.has_sessions ? pointer : default;
                }
                Text {
                    text: root.has_sessions ? "查看明细 >" : "无明细";
                    color: root.has_sessions ? (detail_ta.has_hover ? (root.is_dark ? #7dd3fc : #0284c7) : #38bdf8) : (root.is_dark ? #334155 : #cbd5e1);
                    font-size: 10.5px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}

component SubScaleCacheRow inherits Rectangle {
    in property <string> cache_text: "缓存 0 MB";
    in property <string> scale_text: "100%";
    in property <bool> is_dark: true;
    callback dec_clicked();
    callback inc_clicked();
    callback reset_clicked();

    height: 22px;

    HorizontalLayout {
        alignment: space-between;

        Text {
            text: root.cache_text;
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 11px;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
        }

        HorizontalLayout {
            spacing: 3px;
            alignment: end;

            Text {
                text: "界面";
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 11px;
                vertical-alignment: center;
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: b_dec.has_hover ? (root.is_dark ? #334155 : #cbd5e1) : (root.is_dark ? #1e293b : #e2e8f0);
                border-color: root.is_dark ? #334155 : #cbd5e1;
                border-width: 1px;
                y: (parent.height - 20px) / 2;
                b_dec := TouchArea {
                    clicked => { root.dec_clicked(); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "-";
                    color: root.is_dark ? #cbd5e1 : #334155;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            Rectangle {
                height: 20px;
                border-radius: 4px;
                background: b_reset.has_hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #0d1527 : #ffffff);
                border-color: root.is_dark ? #334155 : #cbd5e1;
                border-width: 1px;
                y: (parent.height - 20px) / 2;
                b_reset := TouchArea {
                    clicked => { root.reset_clicked(); }
                    mouse-cursor: pointer;
                }
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    alignment: center;
                    Text {
                        text: root.scale_text;
                        color: root.is_dark ? #38bdf8 : #0284c7;
                        font-size: 11.5px;
                        font-family: "Cascadia Mono";
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 4px;
                background: b_inc.has_hover ? (root.is_dark ? #334155 : #cbd5e1) : (root.is_dark ? #1e293b : #e2e8f0);
                border-color: root.is_dark ? #334155 : #cbd5e1;
                border-width: 1px;
                y: (parent.height - 20px) / 2;
                b_inc := TouchArea {
                    clicked => { root.inc_clicked(); }
                    mouse-cursor: pointer;
                }
                Text {
                    text: "+";
                    color: root.is_dark ? #cbd5e1 : #334155;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Antigravity 多开分身工具 v1.0.1";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1440px;
    preferred-height: 800px;
    min-width: 1200px;
    min-height: 680px;
    max-width: 1680px;
    max-height: 1020px;
    background: root.is_dark ? (root.redraw_tick == 0 ? #070a13 : #070a14) : (root.redraw_tick == 0 ? #f1f5f9 : #f1f5fa);
    forward-focus: fkey;

    fkey := FocusScope {
        key-pressed(event) => {
            if event.text == "s" || event.text == "S" {
                root.session_modal_slot = 2;
                root.session_modal_visible = !root.session_modal_visible;
                root.show_session_modal(2);
                accept
            }
            if event.text == Key.Escape {
                root.session_modal_visible = false;
                accept
            }
            reject
        }
    }

    in-out property <bool> is_dark: true;
    in-out property <int> redraw_tick: 0;
    in property <string> toast_message: "就绪";

    in property <bool> host_running: false;
    in property <string> host_pid: "--";
    in property <string> host_port: "--";
    in property <float> host_cpu: 0.0;
    in property <string> host_cpu_text: "0.0%";
    in property <float> host_ram: 0.0;
    in property <string> host_ram_text: "0 MB";
    in property <string> host_scale_text: "158%";
    in property <string> host_user_name: "--";
    in property <string> host_user_email: "--";
    in property <string> host_tier: "";
