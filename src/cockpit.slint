import { SessionUiItem } from "ui/session_items.slint";
export { SessionUiItem }

import { PinIcon, SunIcon, MoonIcon } from "ui/icons.slint";
import { ComponentsCard } from "ui/components_card.slint";
import { TelemetryCard } from "ui/telemetry_card.slint";
import { InstanceCard } from "ui/instance_card.slint";
import { StatusToolbar } from "ui/toolbar.slint";
import { ConfirmModal, CleanCacheModal, PatchModal, SessionListModal } from "ui/modals.slint";
import { FloatingWidgetWindow } from "ui/floating_widget.slint";
export { FloatingWidgetWindow }

export component MainWindow inherits Window {
    in property <string> app_version: "";
    title: "Antigravity Lander " + root.app_version;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1500px;
    preferred-height: 870px;
    min-width: 1200px;
    min-height: 720px;
    background: root.is_dark ? (root.redraw_tick == 0 ? #070a13 : #070a14) : (root.redraw_tick == 0 ? #f1f5f9 : #f1f5fa);
    forward-focus: fkey;

    fkey := FocusScope {
        key-pressed(event) => {
            if event.text == "s" || event.text == "S" {
                if root.session_modal_visible {
                    root.session_modal_visible = false;
                } else {
                    root.session_modal_slot = root.live_session_target_slot < 0 ? 0 : root.live_session_target_slot;
                    root.session_modal_visible = true;
                    root.show_session_modal(root.session_modal_slot);
                }
                accept
            }
            if event.text == Key.Escape {
                root.session_modal_visible = false;
                accept
            }
            reject
        }
    }

    in-out property <bool> is_dark: true;
    in-out property <int> redraw_tick: 0;
    in property <string> toast_message: "就绪";

    in property <bool> host_running: false;
    in property <bool> host_token_present: false;
    in property <string> host_pid: "--";
    in property <string> host_port: "--";
    in property <float> host_cpu: 0.0;
    in property <string> host_cpu_text: "0.0%";
    in property <float> host_ram: 0.0;
    in property <string> host_ram_text: "0 MB";
    in property <string> host_scale_text: "158%";
    in property <string> host_user_name: "--";
    in property <string> host_user_email: "--";
    in property <string> host_tier: "";
    in property <image> host_avatar;
    in property <bool> host_has_avatar: false;
    in property <string> host_weekly_text: "--";
    in property <string> host_weekly_reset: "";
    in property <image> host_weekly_ring;
    in property <string> host_five_h_text: "--";
    in property <string> host_five_h_reset: "";
    in property <image> host_five_h_ring;
    in property <bool> host_quota_refreshing: false;
    in property <angle> quota_spin_angle: 0deg;
    in property <string> host_summary_text: "无活动会话";
    in property <bool> host_has_running: false;
    in property <bool> host_has_sessions: false;

    in property <bool> patch_ag2_installed: true;
    in property <string> patch_ag2_version: "--";
    in property <bool> proxy_injected: false;
    in property <string> proxy_status_text: "未注入";

    in property <string> total_mem_text: "0.0 MB";
    in property <float> total_mem_pct: 0.2;
    in property <string> mem_breakdown_text: "主号 0M · 分身 0M";

    in property <bool> sub1_running: false;
    in property <string> sub1_pid: "--";
    in property <string> sub1_port: "--";
    in property <string> sub1_cpu_text: "--";
    in property <string> sub1_ram_text: "--";
    in property <bool> sub1_token_present: false;
    in property <string> sub1_scale_text: "144%";
    in property <string> sub1_user_name: "--";
    in property <string> sub1_user_email: "--";
    in property <string> sub1_tier: "";
    in property <image> sub1_avatar;
    in property <bool> sub1_has_avatar: false;
