                                        Text {
                                            text: "PID " + root.sub4_pid;
                                            color: root.is_dark ? #34d399 : #059669;
                                            font-size: 10.5px;
                                            font-family: "Cascadia Mono";
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if !root.sub4_running : Text {
                                    text: "未运行";
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 10.5px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }

                            UserProfileRow {
                                user_name: root.sub4_user_name;
                                user_email: root.sub4_user_email;
                                tier: root.sub4_tier;
                                avatar: root.sub4_avatar;
                                has_avatar: root.sub4_has_avatar;
                                port_text: root.sub4_port;
                                is_dark: root.is_dark;
                            }

                            SubQuotaCompactBox {
                                weekly_reset: root.sub4_weekly_reset;
                                weekly_pct: root.sub4_weekly_text;
                                weekly_ring: root.sub4_weekly_ring;
                                five_h_reset: root.sub4_five_h_reset;
                                five_h_pct: root.sub4_five_h_text;
                                five_h_ring: root.sub4_five_h_ring;
                                is_dark: root.is_dark;
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                MiniMetricBox { horizontal-stretch: 1; label: "CPU"; val_text: root.sub4_cpu_text; val_color: root.sub4_running ? #34d399 : transparent; is_dark: root.is_dark; }
                                MiniMetricBox { horizontal-stretch: 1; label: "内存"; val_text: root.sub4_ram_text; val_color: root.sub4_running ? #38bdf8 : transparent; is_dark: root.is_dark; }
                                MiniMetricBox { horizontal-stretch: 1; label: "会话总数"; val_text: root.sub4_session_count_text; is_dark: root.is_dark; }
                            }

                            SubSessionCardBox {
                                project_name: root.sub4_recent_project;
                                session_title: root.sub4_recent_title;
                                tokens_text: root.sub4_recent_tokens;
                                time_text: root.sub4_recent_time;
                                is_running: root.sub4_running || root.sub4_has_running;
                                has_sessions: root.sub4_has_sessions;
                                is_dark: root.is_dark;
                                clicked => {
                                    root.session_modal_slot = 4;
                                    root.session_modal_visible = true;
                                    root.show_session_modal(4);
                                }
                            }

                            SubScaleCacheRow {
                                cache_text: root.sub4_cache_size_text;
                                scale_text: root.sub4_scale_text;
                                is_dark: root.is_dark;
                                dec_clicked => { root.adjust_sub_scale(4, -10); }
                                inc_clicked => { root.adjust_sub_scale(4, 10); }
                                reset_clicked => { root.reset_sub_scale(4); }
                            }

                            Rectangle { vertical-stretch: 1; }

                            HorizontalLayout {
                                spacing: 6px;
                                if !root.sub4_running : CompactButton {
                                    horizontal-stretch: 1;
                                    text: "启动";
                                    btn_color: #10b981;
                                    is_dark: root.is_dark;
                                    clicked => { root.action_launch_sub(4); }
                                }
                                if root.sub4_running : CompactButton {
                                    horizontal-stretch: 1;
                                    text: "打开";
                                    btn_color: #38bdf8;
                                    is_dark: root.is_dark;
                                    clicked => { root.action_launch_sub(4); }
                                }
                                if root.sub4_running : CompactButton {
                                    horizontal-stretch: 1;
                                    text: "停止";
                                    btn_color: #f43f5e;
                                    text_color: #ffffff;
                                    is_dark: root.is_dark;
                                    clicked => { root.action_stop_sub(4); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                OutlineButton {
                                    horizontal-stretch: 1;
                                    text: "清理凭据";
                                    is_dark: root.is_dark;
                                    is_disabled: root.sub4_running || !root.sub4_token_present;
                                    clicked => {
                                        root.confirm_modal_slot = 4;
                                        root.confirm_modal_visible = true;
                                    }
                                }
                                OutlineButton {
                                    horizontal-stretch: 1;
                                    text: "打开目录";
                                    is_dark: root.is_dark;
                                    clicked => { root.action_open_sandbox(4); }
                                }
                            }
                        }
                    }
                }
            }
        }

    }

    if root.confirm_modal_visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => {
                root.confirm_modal_visible = false;
            }
        }

        Rectangle {
            width: 350px;
            height: 154px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 8px;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "清理凭据";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text {
                    text: "分身 " + root.confirm_modal_slot + " 登录凭据";
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    OutlineButton {
                        width: 76px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => {
                            root.confirm_modal_visible = false;
                        }
                    }

                    CompactButton {
                        width: 84px;
                        text: "清理";
                        btn_color: #f43f5e;
                        text_color: #ffffff;
                        is_dark: root.is_dark;
                        clicked => {
                            root.confirm_modal_visible = false;
                            root.action_clear_token(root.confirm_modal_slot);
                        }
                    }
                }
            }
        }
    }

    if root.clean_modal_visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => {
                root.clean_modal_visible = false;
            }
        }

        Rectangle {
            width: 400px;
            height: 236px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 8px;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "清理缓存";
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text {
                    text: root.cache_detail_text;
                    wrap: word-wrap;
                    color: root.is_dark ? #cbd5e1 : #475569;
                    font-size: 12px;
                }

                Text {
                    text: root.cache_total_text;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    OutlineButton {
                        width: 76px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => {
                            root.clean_modal_visible = false;
                        }
                    }

                    CompactButton {
                        width: 84px;
                        text: "清理";
                        btn_color: #f43f5e;
                        text_color: #ffffff;
                        is_dark: root.is_dark;
                        clicked => {
                            root.action_clean_cache();
                        }
                    }
                }
            }
        }
    }

    if root.patch_modal_visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.72) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => {
                root.patch_modal_visible = false;
            }
        }

        Rectangle {
            width: 360px;
            height: 160px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #0f172a : #ffffff;
            border-color: root.is_dark ? #334155 : #cbd5e1;
            border-width: 1px;
            border-radius: 8px;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: root.patch_modal_title;
                    color: root.is_dark ? #f8fafc : #0f172a;
                    font-size: 14px;
                    font-weight: 700;
                }

                Text {
                    text: root.patch_modal_msg;
                    color: root.is_dark ? #94a3b8 : #64748b;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    OutlineButton {
                        width: 76px;
                        text: "取消";
                        is_dark: root.is_dark;
                        clicked => {
                            root.patch_modal_visible = false;
                        }
                    }

                    CompactButton {
                        width: 100px;
                        text: root.patch_modal_btn_text;
                        btn_color: #f43f5e;
                        text_color: #ffffff;
                        is_dark: root.is_dark;
                        clicked => {
                            root.patch_modal_visible = false;
                            root.action_patch_modal_confirm();
                        }
                    }
                }
            }
        }
    }

    if root.session_modal_visible : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: root.is_dark ? rgba(0, 0, 0, 0.75) : rgba(0, 0, 0, 0.45);

        TouchArea {
            clicked => {
                root.session_modal_visible = false;
            }
        }

        Rectangle {
            width: Math.min(parent.width - 80px, 1080px);
            height: Math.min(parent.height - 60px, 760px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.is_dark ? #1e1f22 : #ffffff;
            border-color: root.is_dark ? #33373e : #cbd5e1;
            border-width: 1px;
            border-radius: 12px;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 32px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Rectangle {
                            width: 9px;
                            height: 9px;
                            border-radius: 4.5px;
                            background: #38bdf8;
                            y: (parent.height - 9px) / 2;
                        }

                        Text {
                            text: root.session_modal_slot == 0 ? "主账号 会话监视" : ("分身 " + root.session_modal_slot + " 会话监视");
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 5px;
                        background: close_ta.has_hover ? (root.is_dark ? #2b2d31 : #e2e8f0) : transparent;

                        close_ta := TouchArea {
                            clicked => {
                                root.session_modal_visible = false;
                            }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: "×";
                            color: root.is_dark ? #94a3b8 : #64748b;
                            font-size: 20px;
                            font-weight: 700;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.session_modal_items.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "当前无活动会话记录";
                        color: root.is_dark ? #64748b : #94a3b8;
                        font-size: 13.5px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if root.session_modal_items.length > 0 : ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 5px;
                        for item in root.session_modal_items : VerticalLayout {
                            if item.is_group_header : SessionGroupHeader {
                                group_name: item.group_name;
                                count_str: item.group_count_str;
                                has_running: item.group_has_running;
                                is_dark: root.is_dark;
                            }
                            if !item.is_group_header : SessionModalRow {
                                item: item;
                                is_dark: root.is_dark;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    height: 32px;

                    OutlineButton {
                        width: 80px;
                        text: "关闭";
                        is_dark: root.is_dark;
                        clicked => {
                            root.session_modal_visible = false;
                        }
                    }
                }
            }
        }
    }
}

