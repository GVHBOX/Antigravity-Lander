component CompactButton inherits Rectangle {
    in property <string> text;
    in property <color> btn_color: #38bdf8;
    in property <color> text_color: #070a13;
    in property <bool> is_dark: true;
    in property <bool> is_disabled: false;
    callback clicked();

    background: is_disabled ? (root.is_dark ? #111827 : #e2e8f0) : (ta.pressed ? btn_color.darker(15%) : (ta.has_hover ? btn_color.brighter(10%) : btn_color));
    border-color: is_disabled ? (root.is_dark ? #1f2937 : #cbd5e1) : (ta.has_hover ? btn_color.brighter(20%) : btn_color);
    border-width: 1px;
    border-radius: 5px;
    height: 28px;

    ta := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.is_disabled ? default : pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.text;
            color: root.is_disabled ? (root.is_dark ? #4b5563 : #94a3b8) : root.text_color;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <color> hover_color: #38bdf8;
    in property <bool> is_dark: true;
    in property <bool> is_disabled: false;
    callback clicked();

    background: is_disabled ? (root.is_dark ? #090e1c : #f8fafc) : (ta.pressed ? (root.is_dark ? #1e293b : #e2e8f0) : (ta.has_hover ? (root.is_dark ? #131c2b : #f1f5f9) : (root.is_dark ? #090e1c : #f8fafc)));
    border-color: is_disabled ? (root.is_dark ? #162032 : #e2e8f0) : (ta.has_hover ? hover_color : (root.is_dark ? #1e293b : #cbd5e1));
    border-width: 1px;
    border-radius: 5px;
    height: 26px;

    ta := TouchArea {
        enabled: !root.is_disabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.is_disabled ? default : pointer;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.is_disabled ? (root.is_dark ? #475569 : #94a3b8) : (ta.has_hover ? hover_color : (root.is_dark ? #94a3b8 : #475569));
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

component StepButton inherits Rectangle {
    in property <string> text;
    in property <bool> is_dark: true;
    callback clicked();

    background: ta.pressed ? (root.is_dark ? #1e293b : #cbd5e1) : (ta.has_hover ? (root.is_dark ? #162238 : #e2e8f0) : (root.is_dark ? #0d1527 : #f1f5f9));
    border-color: ta.has_hover ? #38bdf8 : (root.is_dark ? #1e293b : #cbd5e1);
    border-width: 1px;
    border-radius: 4px;
    width: 24px;
    height: 24px;

    ta := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    Text {
        text: root.text;
        color: ta.has_hover ? #38bdf8 : (root.is_dark ? #f8fafc : #0f172a);
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component ScaleControl inherits HorizontalLayout {
    in property <string> scale_text: "100%";
    in property <bool> is_dark: true;
    callback dec_clicked();
    callback inc_clicked();
    callback reset_clicked();

    alignment: space-between;
    height: 26px;

    Text {
        text: "界面调节";
        color: root.is_dark ? #64748b : #94a3b8;
        font-size: 11px;
        vertical-alignment: center;
    }

    HorizontalLayout {
        spacing: 4px;
        alignment: end;

        StepButton {
            text: "-";
            is_dark: root.is_dark;
            clicked => { root.dec_clicked(); }
        }

        Rectangle {
            width: 48px;
            height: 24px;
            background: root.is_dark ? #0d1527 : #ffffff;
            border-color: root.is_dark ? #1e293b : #cbd5e1;
            border-width: 1px;
            border-radius: 4px;

            TouchArea {
                clicked => { root.reset_clicked(); }
                mouse-cursor: pointer;
            }

            Text {
                text: root.scale_text;
                color: root.is_dark ? #38bdf8 : #0284c7;
                font-size: 11px;
                font-family: "Cascadia Mono";
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        StepButton {
            text: "+";
            is_dark: root.is_dark;
            clicked => { root.inc_clicked(); }
        }
    }
}

component MetricBox inherits Rectangle {
    in property <string> label;
    in property <string> val_text;
    in property <string> extra_text;
    in property <float> pct: 0.0;
    in property <color> fill_color: #38bdf8;
    in property <bool> is_dark: true;

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 48px;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 2px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: root.label;
                color: root.is_dark ? #64748b : #94a3b8;
                font-size: 10px;
                vertical-alignment: center;
            }
            Text {
                text: root.extra_text;
                color: root.fill_color;
                font-size: 10px;
                font-family: "Cascadia Mono";
                vertical-alignment: center;
            }
        }

        Text {
            text: root.val_text;
            color: root.is_dark ? #f8fafc : #0f172a;
            font-size: 15px;
            font-weight: 700;
            font-family: "Cascadia Mono";
            vertical-alignment: center;
        }

        Rectangle {
            height: 3px;
            background: root.is_dark ? #141c2b : #e2e8f0;
            border-radius: 1.5px;

            Rectangle {
                x: 0;
                width: parent.width * Math.min(1.0, Math.max(0.0, root.pct));
                height: 3px;
                border-radius: 1.5px;
                background: root.fill_color;
            }
        }
    }
}

component MiniMetricBox inherits Rectangle {
    in property <string> label;
    in property <string> val_text;
    in property <bool> is_dark: true;

    background: root.is_dark ? #0d1527 : #ffffff;
    border-color: root.is_dark ? rgba(255, 255, 255, 0.06) : #e2e8f0;
    border-width: 1px;
    border-radius: 4px;
    height: 38px;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 1px;

        Text {
            text: root.label;
            color: root.is_dark ? #64748b : #94a3b8;
            font-size: 10px;
        }

        Text {
            text: root.val_text;
            color: root.is_dark ? #f8fafc : #0f172a;
            font-size: 13px;
            font-weight: 700;
            font-family: "Cascadia Mono";
        }
    }
}

component PatchItemRow inherits Rectangle {
    in property <string> title;
    in property <string> status_text;
    in property <bool> is_installed: false;
    in property <string> btn_text;
    in property <bool> is_dark: true;
    callback btn_clicked();

    background: root.is_dark ? #090e1c : #f8fafc;
    border-color: root.is_dark ? #162032 : #e2e8f0;
    border-width: 1px;
    border-radius: 6px;
    height: 42px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                color: root.is_dark ? #f8fafc : #0f172a;
                font-size: 11.5px;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: 5px;
                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.is_installed ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                    y: (parent.height - 5px) / 2;
                }
                Text {
                    text: root.status_text;
                    color: root.is_installed ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                    font-size: 10.5px;
                    font-family: "Cascadia Mono";
                }
            }
        }

        Rectangle {
            width: 56px;
            height: 24px;
            y: (parent.height - 24px) / 2;
            background: root.is_installed ? (ta.has_hover ? #f43f5e : rgba(244, 63, 94, 0.15)) : (ta.has_hover ? #34d399 : #10b981);
            border-color: root.is_installed ? #f43f5e : #10b981;
            border-width: 1px;
            border-radius: 4px;

            ta := TouchArea {
                clicked => { root.btn_clicked(); }
                mouse-cursor: pointer;
            }

            Text {
                text: root.btn_text;
                color: root.is_installed ? (ta.has_hover ? #ffffff : #f43f5e) : #ffffff;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Antigravity 多开分身工具";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1340px;
    preferred-height: 740px;
    min-width: 1200px;
    min-height: 680px;
    background: root.is_dark ? (root.redraw_tick == 0 ? #070a13 : #070a14) : (root.redraw_tick == 0 ? #f1f5f9 : #f1f5fa);

    in-out property <bool> is_dark: true;
    in-out property <int> redraw_tick: 0;
    in property <string> toast_message: "就绪";

    in property <bool> host_running: false;
    in property <string> host_pid: "--";
    in property <string> host_port: "--";
    in property <float> host_cpu: 0.0;
    in property <string> host_cpu_text: "0.0%";
    in property <float> host_ram: 0.0;
    in property <string> host_ram_text: "0 MB";
    in property <string> host_scale_text: "158%";

    in property <bool> patch_ag2_installed: true;
    in property <string> patch_ag2_version: "--";
    in property <bool> patch_ide_installed: false;
    in property <string> patch_ide_version: "--";
    in property <bool> proxy_injected: false;
    in property <string> proxy_port_text: "7890";

    in property <string> total_mem_text: "0.0 MB";
    in property <float> total_mem_pct: 0.2;
    in property <string> mem_breakdown_text: "主号 0M · 分身 0M";

    in property <bool> sub1_running: false;
    in property <string> sub1_pid: "--";
    in property <string> sub1_port: "--";
    in property <string> sub1_cpu_text: "--";
    in property <string> sub1_ram_text: "--";
    in property <bool> sub1_token_present: false;
    in property <string> sub1_scale_text: "144%";

    in property <bool> sub2_running: false;
    in property <string> sub2_pid: "--";
    in property <string> sub2_port: "--";
    in property <string> sub2_cpu_text: "--";
    in property <string> sub2_ram_text: "--";
    in property <bool> sub2_token_present: false;
    in property <string> sub2_scale_text: "100%";

    in property <bool> sub3_running: false;
    in property <string> sub3_pid: "--";
    in property <string> sub3_port: "--";
    in property <string> sub3_cpu_text: "--";
    in property <string> sub3_ram_text: "--";
    in property <bool> sub3_token_present: false;
    in property <string> sub3_scale_text: "100%";

    in property <bool> sub4_running: false;
    in property <string> sub4_pid: "--";
    in property <string> sub4_port: "--";
    in property <string> sub4_cpu_text: "--";
    in property <string> sub4_ram_text: "--";
    in property <bool> sub4_token_present: false;
    in property <string> sub4_scale_text: "100%";

    callback toggle_theme();
    callback action_launch_host();
    callback action_launch_sub(int);
    callback action_stop_sub(int);
    callback action_clear_token(int);
    callback action_open_sandbox(int);
    callback action_open_app_dir();
    callback action_clean_cache();
    callback action_check_patch();

    callback toggle_patch_ag2();
    callback toggle_patch_ide();
    callback toggle_proxy();

    callback adjust_host_scale(int);
    callback adjust_sub_scale(int, int);
    callback reset_host_scale();
    callback reset_sub_scale(int);

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 12px;
            height: 250px;

            Rectangle {
                horizontal-stretch: 1;
                background: root.is_dark ? #0d1527 : #ffffff;
                border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
                border-width: 1px;
                border-radius: 10px;

                VerticalLayout {
                    padding: 13px;
                    spacing: 9px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 24px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "主账号";
                                color: root.is_dark ? #f8fafc : #0f172a;
                                font-size: 13.5px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: root.is_dark ? rgba(56, 189, 248, 0.12) : #e0f2fe;
                                border-color: rgba(56, 189, 248, 0.25);
                                border-width: 1px;
                                border-radius: 3px;
                                height: 16px;
                                y: (parent.height - 16px) / 2;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: "默认";
                                        color: root.is_dark ? #38bdf8 : #0284c7;
                                        font-size: 10px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 22px;
                            background: root.host_running ? (root.is_dark ? rgba(16, 185, 129, 0.12) : rgba(16, 185, 129, 0.15)) : (root.is_dark ? #090e1c : #f1f5f9);
                            border-color: root.host_running ? rgba(16, 185, 129, 0.3) : (root.is_dark ? #162032 : #cbd5e1);
                            border-width: 1px;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.host_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                                    y: (parent.height - 6px) / 2;
                                }
                                Text {
                                    text: root.host_running ? ("运行中 (PID: " + root.host_pid + ")") : "未运行";
                                    color: root.host_running ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                                    font-size: 10.5px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        MetricBox {
                            horizontal-stretch: 1;
                            label: "CPU";
                            val_text: root.host_cpu_text;
                            extra_text: root.host_running ? "活跃" : "";
                            pct: root.host_cpu / 100.0;
                            fill_color: #10b981;
                            is_dark: root.is_dark;
                        }
                        MetricBox {
                            horizontal-stretch: 1;
                            label: "内存";
                            val_text: root.host_ram_text;
                            extra_text: "RSS";
                            pct: root.host_ram / 1024.0;
                            fill_color: #38bdf8;
                            is_dark: root.is_dark;
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "端口:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 11px; font-family: "Cascadia Mono"; }
                                Text { text: root.host_port; color: root.is_dark ? #38bdf8 : #0284c7; font-size: 11px; font-family: "Cascadia Mono"; font-weight: 600; }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "账号状态:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 11px; font-family: "Cascadia Mono"; }
                                Text { text: "已登录"; color: root.is_dark ? #34d399 : #059669; font-size: 11px; font-family: "Cascadia Mono"; font-weight: 600; }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "路径:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 11px; font-family: "Cascadia Mono"; }
                                Text { text: "%APPDATA%\\Antigravity"; color: root.is_dark ? #94a3b8 : #64748b; font-size: 11px; font-family: "Cascadia Mono"; }
                            }
                        }
                    }

                    ScaleControl {
                        scale_text: root.host_scale_text;
                        is_dark: root.is_dark;
                        dec_clicked => { root.adjust_host_scale(-10); }
                        inc_clicked => { root.adjust_host_scale(10); }
                        reset_clicked => { root.reset_host_scale(); }
                    }

                    CompactButton {
                        text: root.host_running ? "打开" : "启动";
                        btn_color: root.host_running ? #38bdf8 : #10b981;
                        is_dark: root.is_dark;
                        clicked => { root.action_launch_host(); }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: root.is_dark ? #0d1527 : #ffffff;
                border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
                border-width: 1px;
                border-radius: 10px;

                VerticalLayout {
                    padding: 13px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 24px;
                        Text {
                            text: "汉化与代理";
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 13.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        OutlineButton {
                            text: "打开目录";
                            is_dark: root.is_dark;
                            clicked => { root.action_open_app_dir(); }
                        }
                    }

                    PatchItemRow {
                        title: "Antigravity 桌面版";
                        status_text: root.patch_ag2_installed ? ("已汉化 (" + root.patch_ag2_version + ")") : (root.patch_ag2_version == "未安装" ? "未安装" : ("未汉化 (" + root.patch_ag2_version + ")"));
                        is_installed: root.patch_ag2_installed;
                        btn_text: root.patch_ag2_installed ? "卸载" : "安装";
                        is_dark: root.is_dark;
                        btn_clicked => { root.toggle_patch_ag2(); }
                    }

                    PatchItemRow {
                        title: "Antigravity IDE";
                        status_text: root.patch_ide_installed ? ("已汉化 (" + root.patch_ide_version + ")") : (root.patch_ide_version == "未安装" ? "未安装" : ("未汉化 (" + root.patch_ide_version + ")"));
                        is_installed: root.patch_ide_installed;
                        btn_text: root.patch_ide_installed ? "卸载" : "安装";
                        is_dark: root.is_dark;
                        btn_clicked => { root.toggle_patch_ide(); }
                    }

                    PatchItemRow {
                        title: "系统代理 (" + root.proxy_port_text + ")";
                        status_text: root.proxy_injected ? "已注入 (version.dll)" : "未注入";
                        is_installed: root.proxy_injected;
                        btn_text: root.proxy_injected ? "移除" : "注入";
                        is_dark: root.is_dark;
                        btn_clicked => { root.toggle_proxy(); }
                    }

                    OutlineButton {
                        text: "检查补丁";
                        is_dark: root.is_dark;
                        clicked => { root.action_check_patch(); }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: root.is_dark ? #0d1527 : #ffffff;
                border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
                border-width: 1px;
                border-radius: 10px;

                VerticalLayout {
                    padding: 13px;
                    spacing: 9px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 24px;
                        Text {
                            text: "运行概览";
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 13.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.mem_breakdown_text;
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 10.5px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 48px;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "总内存"; color: root.is_dark ? #64748b : #94a3b8; font-size: 10px; }
                                Text { text: root.total_mem_text; color: root.is_dark ? #f8fafc : #0f172a; font-size: 14px; font-weight: 700; font-family: "Cascadia Mono"; }
                            }
                            Rectangle {
                                height: 4px;
                                background: root.is_dark ? #141c2b : #e2e8f0;
                                border-radius: 2px;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * Math.min(1.0, Math.max(0.0, root.total_mem_pct));
                                    height: 4px;
                                    border-radius: 2px;
                                    background: #38bdf8;
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        VerticalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "配置同步:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 11px; font-family: "Cascadia Mono"; }
                                Text { text: "skills / rules / plugins / mcp"; color: root.is_dark ? #34d399 : #059669; font-size: 11px; font-family: "Cascadia Mono"; font-weight: 600; }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "凭据隔离:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 11px; font-family: "Cascadia Mono"; }
                                Text { text: "jetski-standalone-oauth-token"; color: root.is_dark ? #38bdf8 : #0284c7; font-size: 11px; font-family: "Cascadia Mono"; font-weight: 600; }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text { text: "代理状态:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 11px; font-family: "Cascadia Mono"; }
                                Text { text: root.proxy_injected ? "127.0.0.1:7890 (在线)" : "未注入"; color: root.proxy_injected ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8); font-size: 11px; font-family: "Cascadia Mono"; font-weight: 600; }
                            }
                        }
                    }

                    OutlineButton {
                        text: "清理缓存";
                        is_dark: root.is_dark;
                        clicked => { root.action_clean_cache(); }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.is_dark ? #0d1527 : #ffffff;
            border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
            border-width: 1px;
            border-radius: 10px;

            VerticalLayout {
                padding: 13px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 26px;

                    Text {
                        text: "分身管理";
                        color: root.is_dark ? #f8fafc : #0f172a;
                        font-size: 13.5px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 4px;
                        border-color: root.is_dark ? #1e293b : #cbd5e1;
                        border-width: 1px;
                        background: theme_ta.has_hover ? (root.is_dark ? #162032 : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);

                        theme_ta := TouchArea {
                            clicked => { root.toggle_theme(); }
                            mouse-cursor: pointer;
                        }

                        Text {
                            text: root.is_dark ? "☀" : "🌙";
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.sub1_running ? rgba(16, 185, 129, 0.4) : (root.is_dark ? #162032 : #e2e8f0);
                        border-width: 1px;
                        border-radius: 8px;

                        VerticalLayout {
                            padding: 11px;
                            spacing: 8px;

                            HorizontalLayout {
                                alignment: space-between;
                                height: 22px;
                                HorizontalLayout {
                                    spacing: 5px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: root.sub1_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                                        y: (parent.height - 6px) / 2;
                                    }
                                    Text {
                                        text: "分身 1";
                                        color: root.is_dark ? #f8fafc : #0f172a;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: root.sub1_running ? ("PID: " + root.sub1_pid) : "未运行";
                                    color: root.sub1_running ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                                    font-size: 10.5px;
                                    font-family: "Cascadia Mono";
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "目录: data/instance_1";
                                color: root.is_dark ? #64748b : #94a3b8;
                                font-size: 10.5px;
                                font-family: "Cascadia Mono";
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                MiniMetricBox { horizontal-stretch: 1; label: "CPU"; val_text: root.sub1_cpu_text; is_dark: root.is_dark; }
                                MiniMetricBox { horizontal-stretch: 1; label: "内存"; val_text: root.sub1_ram_text; is_dark: root.is_dark; }
                            }

                            Rectangle {
                                background: root.is_dark ? #0d1527 : #ffffff;
                                border-color: root.is_dark ? rgba(255, 255, 255, 0.05) : #e2e8f0;
                                border-width: 1px;
                                border-radius: 4px;
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "端口:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 10.5px; font-family: "Cascadia Mono"; }
                                        Text { text: root.sub1_port; color: root.is_dark ? #38bdf8 : #0284c7; font-size: 10.5px; font-family: "Cascadia Mono"; font-weight: 600; }
                                    }
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "账号:"; color: root.is_dark ? #64748b : #94a3b8; font-size: 10.5px; font-family: "Cascadia Mono"; }
                                        Text { text: root.sub1_token_present ? "已登录" : "未登录"; color: root.sub1_token_present ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8); font-size: 10.5px; font-family: "Cascadia Mono"; font-weight: 600; }
                                    }
                                }
                            }

                            ScaleControl {
                                scale_text: root.sub1_scale_text;
                                is_dark: root.is_dark;
                                dec_clicked => { root.adjust_sub_scale(1, -10); }
                                inc_clicked => { root.adjust_sub_scale(1, 10); }
                                reset_clicked => { root.reset_sub_scale(1); }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                CompactButton {
                                    horizontal-stretch: 1;
                                    text: root.sub1_running ? "打开" : "启动";
                                    btn_color: root.sub1_running ? #38bdf8 : #10b981;
                                    is_dark: root.is_dark;
                                    clicked => { root.action_launch_sub(1); }
                                }
                                if root.sub1_running : CompactButton {
                                    horizontal-stretch: 1;
                                    text: "停止";
                                    btn_color: #f43f5e;
                                    text_color: #ffffff;
                                    is_dark: root.is_dark;
                                    clicked => { root.action_stop_sub(1); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                OutlineButton {
                                    horizontal-stretch: 1;
                                    text: "清理凭据";
                                    is_dark: root.is_dark;
                                    is_disabled: root.sub1_running || !root.sub1_token_present;
                                    clicked => { root.action_clear_token(1); }
                                }
                                OutlineButton {
                                    horizontal-stretch: 1;
                                    text: "打开目录";
                                    is_dark: root.is_dark;
                                    clicked => { root.action_open_sandbox(1); }
                                }
                            }
                        }
