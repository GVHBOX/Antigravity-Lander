    in property <string> sub2_scale_text: "100%";
    in property <string> sub2_user_name: "--";
    in property <string> sub2_user_email: "--";
    in property <string> sub2_tier: "";
    in property <image> sub2_avatar;
    in property <bool> sub2_has_avatar: false;
    in property <string> sub2_weekly_text: "--";
    in property <string> sub2_weekly_reset: "";
    in property <image> sub2_weekly_ring;
    in property <string> sub2_five_h_text: "--";
    in property <string> sub2_five_h_reset: "";
