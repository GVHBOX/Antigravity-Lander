        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-bottom: 10px;

            StatusToolbar {
                horizontal-stretch: 1;
                is_dark: root.is_dark;
                sound_on: root.sound_on;
                preview_sound => { root.preview_sound(); }
                toggle_sound => { root.toggle_sound(); }
            }
