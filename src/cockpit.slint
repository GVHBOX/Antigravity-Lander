import { SessionUiItem } from "ui/session_items.slint";
export { SessionUiItem }

import { PinIcon, SunIcon, MoonIcon, SpeakerIcon, SpeakerMuteIcon } from "ui/icons.slint";
import { ComponentsCard } from "ui/components_card.slint";
import { TelemetryCard } from "ui/telemetry_card.slint";
import { InstanceCard } from "ui/instance_card.slint";
import { ModelQuotaRow } from "ui/widgets.slint";
import { ConfirmModal, CleanCacheModal, PatchModal, SessionListModal } from "ui/modals.slint";



export component MainWindow inherits Window {
    in property <string> app_version: "";
    title: "Antigravity Lander " + root.app_version;
    icon: @image-url("../assets/icon.png");
    preferred-width: 2250px;
    preferred-height: 1305px;
    min-width: 2050px;
    min-height: 1160px;
    background: root.is_dark ? (root.redraw_tick == 0 ? #070a13 : #070a14) : (root.redraw_tick == 0 ? #f1f5f9 : #f1f5fa);
    forward-focus: fkey;

    fkey := FocusScope {
        key-pressed(event) => {
            if event.text == "s" || event.text == "S" {
                if root.session_modal_visible {
                    root.session_modal_visible = false;
                } else {
                    root.session_modal_slot = root.live_session_target_slot < 0 ? 0 : root.live_session_target_slot;
                    root.session_modal_visible = true;
                    root.show_session_modal(root.session_modal_slot);
                }
                accept
            }
            if event.text == Key.Escape {
                root.session_modal_visible = false;
                root.confirm_modal_visible = false;
                root.clean_modal_visible = false;
                root.patch_modal_visible = false;
                accept
            }
            reject
        }
    }

    in-out property <bool> is_dark: true;
    in-out property <int> redraw_tick: 0;

    in property <bool> host_running: false;
    in property <bool> host_token_present: false;
    in property <string> host_pid: "--";
    in property <string> host_port: "--";
    in property <string> host_scale_text: "158%";
    in property <string> host_user_name: "--";
    in property <string> host_user_email: "--";
    in property <string> host_tier: "";
    in property <image> host_avatar;
    in property <bool> host_has_avatar: false;
    in property <[ModelQuotaRow]> host_model_quotas: [];
    in property <bool> host_has_running: false;
    in property <bool> host_has_sessions: false;

    in property <bool> patch_ag2_installed: true;
    in property <string> patch_ag2_version: "--";
    in property <bool> proxy_injected: false;
    in property <string> proxy_status_text: "未注入";



    in property <bool> sub1_running: false;
    in property <string> sub1_pid: "--";
    in property <string> sub1_port: "--";
    in property <bool> sub1_token_present: false;
    in property <string> sub1_scale_text: "144%";
    in property <string> sub1_user_name: "--";
    in property <string> sub1_user_email: "--";
    in property <string> sub1_tier: "";
    in property <image> sub1_avatar;
    in property <bool> sub1_has_avatar: false;
    in property <[ModelQuotaRow]> sub1_model_quotas: [];
    in property <bool> sub1_has_running: false;
    in property <bool> sub1_has_sessions: false;

    in property <bool> sub2_running: false;
    in property <string> sub2_pid: "--";
    in property <string> sub2_port: "--";
    in property <bool> sub2_token_present: false;
    in property <string> sub2_scale_text: "100%";
    in property <string> sub2_user_name: "--";
    in property <string> sub2_user_email: "--";
    in property <string> sub2_tier: "";
    in property <image> sub2_avatar;
    in property <bool> sub2_has_avatar: false;
    in property <[ModelQuotaRow]> sub2_model_quotas: [];
    in property <bool> sub2_has_running: false;
    in property <bool> sub2_has_sessions: false;

    in property <bool> sub3_running: false;
    in property <string> sub3_pid: "--";
    in property <string> sub3_port: "--";
    in property <bool> sub3_token_present: false;
    in property <string> sub3_scale_text: "100%";
    in property <string> sub3_user_name: "--";
    in property <string> sub3_user_email: "--";
    in property <string> sub3_tier: "";
    in property <image> sub3_avatar;
    in property <bool> sub3_has_avatar: false;
    in property <[ModelQuotaRow]> sub3_model_quotas: [];
    in property <bool> sub3_has_running: false;
    in property <bool> sub3_has_sessions: false;

    in property <bool> sub4_running: false;
    in property <string> sub4_pid: "--";
    in property <string> sub4_port: "--";
    in property <bool> sub4_token_present: false;
    in property <string> sub4_scale_text: "100%";
    in property <string> sub4_user_name: "--";
    in property <string> sub4_user_email: "--";
    in property <string> sub4_tier: "";
    in property <image> sub4_avatar;
    in property <bool> sub4_has_avatar: false;
    in property <[ModelQuotaRow]> sub4_model_quotas: [];
    in property <bool> sub4_has_running: false;
    in property <bool> sub4_has_sessions: false;

    in-out property <bool> confirm_modal_visible: false;
    in-out property <int> confirm_modal_slot: 0;
    in-out property <bool> clean_modal_visible: false;
    in property <string> cache_detail_text: "";
    in property <string> cache_total_text: "";
    in-out property <bool> patch_modal_visible: false;
    in property <string> patch_modal_title: "Antigravity 正在运行";
    in property <string> patch_modal_msg: "文件被运行中的实例占用，需退出后继续。";
    in property <string> patch_modal_btn_text: "关闭并应用";

    in-out property <bool> session_modal_visible: false;
    in-out property <int> session_modal_slot: 0;
    in property <[SessionUiItem]> session_modal_items: [];
    callback show_session_modal(int);

    in property <string> cache_summary_text: "无缓存占用";

    in-out property <int> live_session_target_slot: -1;
    in-out property <string> live_session_target_text: "自动跟随";
    in property <bool> live_session_is_running: false;
    in property <string> live_session_status_text: "";
    in property <string> live_session_project: "--";
    in property <string> live_session_title: "无活动会话";
    in property <string> live_model_name: "--";
    in property <string> live_model_level: "";
    in property <string> live_session_speed_text: "0.0";
    in property <string> live_session_speed_sub: "无吞吐";
    in property <string> live_hover_tag: "";
    in property <bool> live_is_hovering_bar: false;
    in property <string> live_peak_tps_text: "Pk 0.0";
    in property <string> live_avg_tps_text: "Avg 0";
    in property <float> live_avg_line_pct: 0.5;

    in property <[float]> live_bars: [];

    in property <string> live_session_context_text: "0 / 256K (0.0%)";
    in property <float> live_session_context_pct: 0.0;

    in property <string> live_cache_hit_text: "缓存命中率 0.0%";
    in property <string> live_step_text: "步数 #0";
    in property <string> live_compact_text: "压缩 0 次";
    callback switch_live_session_target(int);
    callback bar_hover(int);
    callback bar_leave();

    callback toggle_theme();
    callback action_launch_host();
    callback action_launch_sub(int);
    callback action_stop_sub(int);
    callback action_clear_token(int);
    callback action_open_dir(int);
    callback action_clean_cache();
    callback action_scan_cache();

    callback toggle_patch_ag2();
    callback toggle_proxy();
    callback action_patch_modal_confirm();

    callback adjust_host_scale(int);
    callback adjust_sub_scale(int, int);
    callback reset_host_scale();
    callback reset_sub_scale(int);

    in-out property <bool> is_pinned: false;
    callback toggle_pin_window();

    callback action_stop_host();
    in property <bool> sound_on: true;
    callback toggle_sound();





    in property <float> live_prompt_pct: 0.01;
    in property <float> live_cache_pct: 0.0;
    in property <float> live_output_pct: 0.01;
    in property <string> live_prompt_text: "输入 0";
    in property <string> live_cache_legend: "缓存读取 0";
    in property <string> live_output_text: "输出 0";
    in property <string> host_session_count_text: "--";
    in property <string> host_cache_size_text: "主机实例";
    in property <string> host_recent_project: "无活动会话";
    in property <string> host_recent_title: "";
    in property <string> host_recent_tokens: "";
    in property <string> host_recent_time: "等待初始化";
    in property <[SessionUiItem]> host_session_items: [];
    in property <[SessionUiItem]> sub1_session_items: [];
    in property <[SessionUiItem]> sub2_session_items: [];
    in property <[SessionUiItem]> sub3_session_items: [];
    in property <[SessionUiItem]> sub4_session_items: [];

    in property <string> sub1_session_count_text: "--";
    in property <string> sub2_session_count_text: "--";
    in property <string> sub3_session_count_text: "--";
    in property <string> sub4_session_count_text: "--";
    in property <string> sub1_cache_size_text: "缓存 0 MB";
    in property <string> sub2_cache_size_text: "缓存 0 MB";
    in property <string> sub3_cache_size_text: "缓存 0 MB";
    in property <string> sub4_cache_size_text: "缓存 0 MB";
    in property <string> sub1_recent_project: "无活动会话";
    in property <string> sub1_recent_title: "";
    in property <string> sub1_recent_tokens: "";
    in property <string> sub1_recent_time: "等待初始化";
    in property <string> sub2_recent_project: "无活动会话";
    in property <string> sub2_recent_title: "";
    in property <string> sub2_recent_tokens: "";
    in property <string> sub2_recent_time: "等待初始化";
    in property <string> sub3_recent_project: "无活动会话";
    in property <string> sub3_recent_title: "";
    in property <string> sub3_recent_tokens: "";
    in property <string> sub3_recent_time: "等待初始化";
    in property <string> sub4_recent_project: "无活动会话";
    in property <string> sub4_recent_title: "";
    in property <string> sub4_recent_tokens: "";
    in property <string> sub4_recent_time: "等待初始化";

    VerticalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 15px;
        padding-bottom: 15px;
        spacing: 12px;

            Rectangle {
                vertical-stretch: 1;
                min-height: 540px;
                preferred-height: 540px;

                HorizontalLayout {
                    spacing: 12px;

                    ComponentsCard {
                        horizontal-stretch: 5;
                        patch_ag2_installed: root.patch_ag2_installed;
                        patch_ag2_version: root.patch_ag2_version;
                        proxy_injected: root.proxy_injected;
                        proxy_status_text: root.proxy_status_text;




                        cache_summary_text: root.cache_summary_text;
                        is_dark: root.is_dark;

                        toggle_patch_ag2 => { root.toggle_patch_ag2(); }
                        toggle_proxy => { root.toggle_proxy(); }
                        scan_cache => { root.action_scan_cache(); }
                    }

                    TelemetryCard {
                        horizontal-stretch: 7;
                        live_session_is_running: root.live_session_is_running;
                        live_session_target_text: root.live_session_target_text;
                        live_session_target_slot: root.live_session_target_slot;
                        live_session_project: root.live_session_project;
                        live_session_status_text: root.live_session_status_text;
                        live_session_title: root.live_session_title;
                        live_session_speed_text: root.live_session_speed_text;
                        live_session_speed_sub: root.live_session_speed_sub;
                        live_hover_tag: root.live_hover_tag;
                        live_is_hovering_bar: root.live_is_hovering_bar;
                        live_peak_tps_text: root.live_peak_tps_text;
                        live_avg_tps_text: root.live_avg_tps_text;
                        live_avg_line_pct: root.live_avg_line_pct;
                        live_bars: root.live_bars;
                        live_session_context_text: root.live_session_context_text;
                        live_session_context_pct: root.live_session_context_pct;
                        live_prompt_pct: root.live_prompt_pct;
                        live_cache_pct: root.live_cache_pct;
                        live_output_pct: root.live_output_pct;
                        live_prompt_text: root.live_prompt_text;
                        live_cache_legend: root.live_cache_legend;
                        live_output_text: root.live_output_text;
                        live_cache_hit_text: root.live_cache_hit_text;
                        live_step_text: root.live_step_text;
                        live_compact_text: root.live_compact_text;
                        live_model_name: root.live_model_name;
                        live_model_level: root.live_model_level;
                        is_dark: root.is_dark;


                        switch_target(target) => { root.switch_live_session_target(target); }

                        bar_hover(idx) => { root.bar_hover(idx); }
                        bar_leave() => { root.bar_leave(); }
                    }
                }
            }

        Rectangle {
            vertical-stretch: 1;
            preferred-height: 525px;
            min-height: 480px;
            background: root.is_dark ? #0d1527 : #ffffff;
            border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
            border-width: 1px;
            border-radius: 15px;
            clip: true;

            VerticalLayout {
                padding-left: 15px;
                padding-right: 15px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 9px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 39px;

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Text {
                            text: "账号与额度看板";
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 21px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: end;

                        Rectangle {
                            width: 39px;
                            height: 39px;
                            border-radius: 8px;
                            border-color: sound_ta.has_hover ? (root.is_dark ? #334155 : #94a3b8) : (root.is_dark ? #1e293b : #cbd5e1);
                            border-width: 1px;
                            background: root.sound_on ? (sound_ta.has_hover ? (root.is_dark ? rgba(56, 189, 248, 0.28) : rgba(56, 189, 248, 0.20)) : (root.is_dark ? rgba(56, 189, 248, 0.20) : rgba(56, 189, 248, 0.14))) : (sound_ta.has_hover ? (root.is_dark ? #162032 : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc));

                            sound_ta := TouchArea {
                                clicked => { root.toggle_sound(); }
                                mouse-cursor: pointer;
                            }

                            if root.sound_on : SpeakerIcon {
                                icon_color: sound_ta.has_hover ? #f8fafc : #38bdf8;
                                x: (parent.width - 22px) / 2;
                                y: (parent.height - 22px) / 2;
                            }
                            if !root.sound_on : SpeakerMuteIcon {
                                icon_color: sound_ta.has_hover ? (root.is_dark ? #cbd5e1 : #334155) : (root.is_dark ? #64748b : #94a3b8);
                                x: (parent.width - 22px) / 2;
                                y: (parent.height - 22px) / 2;
                            }
                        }

                        Rectangle {
                            width: 39px;
                            height: 39px;
                            border-radius: 8px;
                            border-color: pin_ta.has_hover ? (root.is_dark ? #334155 : #94a3b8) : (root.is_dark ? #1e293b : #cbd5e1);
                            border-width: 1px;
                            background: root.is_pinned ? (pin_ta.has_hover ? (root.is_dark ? rgba(56, 189, 248, 0.28) : rgba(56, 189, 248, 0.20)) : (root.is_dark ? rgba(56, 189, 248, 0.20) : rgba(56, 189, 248, 0.14))) : (pin_ta.has_hover ? (root.is_dark ? #162032 : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc));

                            pin_ta := TouchArea {
                                clicked => { root.toggle_pin_window(); }
                                mouse-cursor: pointer;
                            }

                            PinIcon {
                                icon_color: root.is_pinned ? #38bdf8 : (pin_ta.has_hover ? (root.is_dark ? #cbd5e1 : #334155) : (root.is_dark ? #64748b : #94a3b8));
                                x: (parent.width - 18px) / 2;
                                y: (parent.height - 18px) / 2;
                            }
                        }

                        Rectangle {
                            width: 39px;
                            height: 39px;
                            border-radius: 8px;
                            border-color: theme_ta.has_hover ? (root.is_dark ? #334155 : #94a3b8) : (root.is_dark ? #1e293b : #cbd5e1);
                            border-width: 1px;
                            background: theme_ta.has_hover ? (root.is_dark ? #162032 : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);

                            theme_ta := TouchArea {
                                clicked => { root.toggle_theme(); }
                                mouse-cursor: pointer;
                            }

                            if root.is_dark : SunIcon {
                                icon_color: theme_ta.has_hover ? #f8fafc : #94a3b8;
                                x: (parent.width - 20px) / 2;
                                y: (parent.height - 20px) / 2;
                            }
                            if !root.is_dark : MoonIcon {
                                icon_color: theme_ta.has_hover ? #0f172a : #64748b;
                                x: (parent.width - 20px) / 2;
                                y: (parent.height - 20px) / 2;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;

                    InstanceCard {
                        slot: 0;
                        title_text: "主账号";
                        instance_id_text: "host";
                        dir_button_text: "程序目录";
                        card_stretch: 1;
                        card_max_height: 150000px;
                        content_padding_bottom: 9px;
                        content_fill: true;
                        is_running: root.host_running;
                        pid_text: root.host_pid;
                        user_name: root.host_user_name;
                        user_email: root.host_user_email;
                        tier: root.host_tier;
                        avatar: root.host_avatar;
                        has_avatar: root.host_has_avatar;
                        port_text: root.host_port;
                        model_quotas: root.host_model_quotas;
                        token_present: root.host_token_present;
                        session_count_text: root.host_session_count_text;
                        recent_project: root.host_recent_project;
                        recent_title: root.host_recent_title;
                        recent_tokens: root.host_recent_tokens;
                        recent_time: root.host_recent_time;
                        has_running_session: root.host_has_running;
                        has_sessions: root.host_has_sessions;
                        session_items: root.host_session_items;
                        cache_size_text: root.host_cache_size_text;
                        scale_text: root.host_scale_text;
                        is_dark: root.is_dark;

                        session_clicked => {
                            root.session_modal_slot = 0;
                            root.session_modal_visible = true;
                            root.show_session_modal(0);
                        }
                        adjust_scale(delta) => { root.adjust_host_scale(delta); }
                        reset_scale => { root.reset_host_scale(); }
                        launch => { root.action_launch_host(); }
                        stop => { root.action_stop_host(); }
                        clear_token => {
                            root.confirm_modal_slot = 0;
                            root.confirm_modal_visible = true;
                        }
                        open_dir => { root.action_open_dir(0); }
                    }

                        InstanceCard {
                            slot: 1;
                            title_text: "分身 1";
                            instance_id_text: "instance_1";
                            card_stretch: 1;
                            card_max_height: 150000px;
                            content_padding_bottom: 9px;
                            content_fill: true;
                            is_running: root.sub1_running;
                            pid_text: root.sub1_pid;
                            user_name: root.sub1_user_name;
                            user_email: root.sub1_user_email;
                            tier: root.sub1_tier;
                            avatar: root.sub1_avatar;
                            has_avatar: root.sub1_has_avatar;
                            port_text: root.sub1_port;
                        model_quotas: root.sub1_model_quotas;
                            token_present: root.sub1_token_present;
                            session_count_text: root.sub1_session_count_text;
                            recent_project: root.sub1_recent_project;
                            recent_title: root.sub1_recent_title;
                            recent_tokens: root.sub1_recent_tokens;
                            recent_time: root.sub1_recent_time;
                            has_running_session: root.sub1_has_running;
                            has_sessions: root.sub1_has_sessions;
                            session_items: root.sub1_session_items;
                            cache_size_text: root.sub1_cache_size_text;
                            scale_text: root.sub1_scale_text;
                            is_dark: root.is_dark;

                            session_clicked => {
                                root.session_modal_slot = 1;
                                root.session_modal_visible = true;
                                root.show_session_modal(1);
                            }
                            adjust_scale(delta) => { root.adjust_sub_scale(1, delta); }
                            reset_scale => { root.reset_sub_scale(1); }
                            launch => { root.action_launch_sub(1); }
                            stop => { root.action_stop_sub(1); }
                            clear_token => {
                                root.confirm_modal_slot = 1;
                                root.confirm_modal_visible = true;
                            }
                            open_dir => { root.action_open_dir(1); }
                        }

                        InstanceCard {
                            slot: 2;
                            title_text: "分身 2";
                            instance_id_text: "instance_2";
                            card_stretch: 1;
                            card_max_height: 150000px;
                            content_padding_bottom: 9px;
                            content_fill: true;
                            is_running: root.sub2_running;
                            pid_text: root.sub2_pid;
                            user_name: root.sub2_user_name;
                            user_email: root.sub2_user_email;
                            tier: root.sub2_tier;
                            avatar: root.sub2_avatar;
                            has_avatar: root.sub2_has_avatar;
                            port_text: root.sub2_port;
                        model_quotas: root.sub2_model_quotas;
                            token_present: root.sub2_token_present;
                            session_count_text: root.sub2_session_count_text;
                            recent_project: root.sub2_recent_project;
                            recent_title: root.sub2_recent_title;
                            recent_tokens: root.sub2_recent_tokens;
                            recent_time: root.sub2_recent_time;
                            has_running_session: root.sub2_has_running;
                            has_sessions: root.sub2_has_sessions;
                            session_items: root.sub2_session_items;
                            cache_size_text: root.sub2_cache_size_text;
                            scale_text: root.sub2_scale_text;
                            is_dark: root.is_dark;

                            session_clicked => {
                                root.session_modal_slot = 2;
                                root.session_modal_visible = true;
                                root.show_session_modal(2);
                            }
                            adjust_scale(delta) => { root.adjust_sub_scale(2, delta); }
                            reset_scale => { root.reset_sub_scale(2); }
                            launch => { root.action_launch_sub(2); }
                            stop => { root.action_stop_sub(2); }
                            clear_token => {
                                root.confirm_modal_slot = 2;
                                root.confirm_modal_visible = true;
                            }
                            open_dir => { root.action_open_dir(2); }
                        }

                        InstanceCard {
                            slot: 3;
                            title_text: "分身 3";
                            instance_id_text: "instance_3";
                            card_stretch: 1;
                            card_max_height: 150000px;
                            content_padding_bottom: 9px;
                            content_fill: true;
                            is_running: root.sub3_running;
                            pid_text: root.sub3_pid;
                            user_name: root.sub3_user_name;
                            user_email: root.sub3_user_email;
                            tier: root.sub3_tier;
                            avatar: root.sub3_avatar;
                            has_avatar: root.sub3_has_avatar;
                            port_text: root.sub3_port;
                        model_quotas: root.sub3_model_quotas;
                            token_present: root.sub3_token_present;
                            session_count_text: root.sub3_session_count_text;
                            recent_project: root.sub3_recent_project;
                            recent_title: root.sub3_recent_title;
                            recent_tokens: root.sub3_recent_tokens;
                            recent_time: root.sub3_recent_time;
                            has_running_session: root.sub3_has_running;
                            has_sessions: root.sub3_has_sessions;
                            session_items: root.sub3_session_items;
                            cache_size_text: root.sub3_cache_size_text;
                            scale_text: root.sub3_scale_text;
                            is_dark: root.is_dark;

                            session_clicked => {
                                root.session_modal_slot = 3;
                                root.session_modal_visible = true;
                                root.show_session_modal(3);
                            }
                            adjust_scale(delta) => { root.adjust_sub_scale(3, delta); }
                            reset_scale => { root.reset_sub_scale(3); }
                            launch => { root.action_launch_sub(3); }
                            stop => { root.action_stop_sub(3); }
                            clear_token => {
                                root.confirm_modal_slot = 3;
                                root.confirm_modal_visible = true;
                            }
                            open_dir => { root.action_open_dir(3); }
                        }

                        InstanceCard {
                            slot: 4;
                            title_text: "分身 4";
                            instance_id_text: "instance_4";
                            card_stretch: 1;
                            card_max_height: 150000px;
                            content_padding_bottom: 9px;
                            content_fill: true;
                            is_running: root.sub4_running;
                            pid_text: root.sub4_pid;
                            user_name: root.sub4_user_name;
                            user_email: root.sub4_user_email;
                            tier: root.sub4_tier;
                            avatar: root.sub4_avatar;
                            has_avatar: root.sub4_has_avatar;
                            port_text: root.sub4_port;
                        model_quotas: root.sub4_model_quotas;
                            token_present: root.sub4_token_present;
                            session_count_text: root.sub4_session_count_text;
                            recent_project: root.sub4_recent_project;
                            recent_title: root.sub4_recent_title;
                            recent_tokens: root.sub4_recent_tokens;
                            recent_time: root.sub4_recent_time;
                            has_running_session: root.sub4_has_running;
                            has_sessions: root.sub4_has_sessions;
                            session_items: root.sub4_session_items;
                            cache_size_text: root.sub4_cache_size_text;
                            scale_text: root.sub4_scale_text;
                            is_dark: root.is_dark;

                            session_clicked => {
                                root.session_modal_slot = 4;
                                root.session_modal_visible = true;
                                root.show_session_modal(4);
                            }
                            adjust_scale(delta) => { root.adjust_sub_scale(4, delta); }
                            reset_scale => { root.reset_sub_scale(4); }
                            launch => { root.action_launch_sub(4); }
                            stop => { root.action_stop_sub(4); }
                            clear_token => {
                                root.confirm_modal_slot = 4;
                                root.confirm_modal_visible = true;
                            }
                            open_dir => { root.action_open_dir(4); }
                        }
                    }
                }
            }

    }


    ConfirmModal {
        is_visible: root.confirm_modal_visible;
        slot: root.confirm_modal_slot;
        is_dark: root.is_dark;
        cancel => { root.confirm_modal_visible = false; }
        confirm(slot) => {
            root.confirm_modal_visible = false;
            root.action_clear_token(slot);
        }
    }

    CleanCacheModal {
        is_visible: root.clean_modal_visible;
        detail_text: root.cache_detail_text;
        total_text: root.cache_total_text;
        is_dark: root.is_dark;
        cancel => { root.clean_modal_visible = false; }
        confirm => {
            root.clean_modal_visible = false;
            root.action_clean_cache();
        }
    }

    PatchModal {
        is_visible: root.patch_modal_visible;
        title_text: root.patch_modal_title;
        msg_text: root.patch_modal_msg;
        btn_text: root.patch_modal_btn_text;
        is_dark: root.is_dark;
        cancel => { root.patch_modal_visible = false; }
        confirm => {
            root.patch_modal_visible = false;
            root.action_patch_modal_confirm();
        }
    }

    SessionListModal {
        is_visible: root.session_modal_visible;
        slot: root.session_modal_slot;
        items: root.session_modal_items;
        is_dark: root.is_dark;
        close => { root.session_modal_visible = false; }
    }
}
