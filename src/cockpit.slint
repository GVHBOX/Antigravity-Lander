    in property <string> sub4_recent_title: "";
    in property <string> sub4_recent_tokens: "";
    in property <string> sub4_recent_time: "等待初始化";

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Rectangle {
            vertical-stretch: 0;
            min-height: 285px;
            max-height: 285px;
            preferred-height: 285px;

            HorizontalLayout {
                spacing: 8px;

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-height: 285px;
                background: root.is_dark ? #0d1527 : #ffffff;
                border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
                border-width: 1px;
                border-radius: 10px;
                clip: true;

                VerticalLayout {
                    padding: 10px;
                    spacing: 5px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 22px;

                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: "主账号";
                                color: root.is_dark ? #f8fafc : #0f172a;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 22px;
                            background: root.host_running ? (root.is_dark ? rgba(16, 185, 129, 0.12) : rgba(16, 185, 129, 0.15)) : (root.is_dark ? #090e1c : #f1f5f9);
                            border-color: root.host_running ? rgba(16, 185, 129, 0.3) : (root.is_dark ? #162032 : #cbd5e1);
                            border-width: 1px;
                            border-radius: 4px;
                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                spacing: 4px;
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: root.host_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                                    y: (parent.height - 6px) / 2;
                                }
                                Text {
                                    text: root.host_running ? ("运行中 (PID: " + root.host_pid + ")") : "未运行";
                                    color: root.host_running ? (root.is_dark ? #34d399 : #059669) : (root.is_dark ? #64748b : #94a3b8);
                                    font-size: 10.5px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    UserProfileRow {
                        user_name: root.host_user_name;
                        user_email: root.host_user_email;
                        tier: root.host_tier;
                        avatar: root.host_avatar;
                        has_avatar: root.host_has_avatar;
                        port_text: root.host_port;
                        is_dark: root.is_dark;
                    }

                    QuotaNativeBox {
                        weekly_reset: root.host_weekly_reset;
                        weekly_pct: root.host_weekly_text;
                        weekly_ring: root.host_weekly_ring;
                        five_h_reset: root.host_five_h_reset;
                        five_h_pct: root.host_five_h_text;
                        five_h_ring: root.host_five_h_ring;
                        is_dark: root.is_dark;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        MiniMetricBox { horizontal-stretch: 1; label: "CPU"; val_text: root.host_cpu_text; is_dark: root.is_dark; }
                        MiniMetricBox { horizontal-stretch: 1; label: "物理内存"; val_text: root.host_ram_text; is_dark: root.is_dark; }
                        MiniMetricBox { horizontal-stretch: 1; label: "已运行时长"; val_text: root.host_uptime_text; is_dark: root.is_dark; }
                    }

                    SessionSummaryRow {
                        summary_text: root.host_summary_text;
                        is_running: root.host_has_running;
                        has_sessions: root.host_has_sessions;
                        is_dark: root.is_dark;
                        clicked => {
                            root.session_modal_slot = 0;
                            root.session_modal_visible = true;
                            root.show_session_modal(0);
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 8px;
                        height: 38px;

                        ScaleControl {
                            horizontal-stretch: 1;
                            scale_text: root.host_scale_text;
                            is_dark: root.is_dark;
                            dec_clicked => { root.adjust_host_scale(-10); }
                            inc_clicked => { root.adjust_host_scale(10); }
                            reset_clicked => { root.reset_host_scale(); }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            CompactButton {
                                width: 85px;
                                btn_height: 36px;
                                text: root.host_running ? "打开" : "启动";
                                btn_color: root.host_running ? #38bdf8 : #10b981;
                                is_dark: root.is_dark;
                                clicked => { root.action_launch_host(); }
                            }
                            if root.host_running : CompactButton {
                                width: 75px;
                                btn_height: 36px;
                                text: "停止";
                                btn_color: #f43f5e;
                                text_color: #ffffff;
                                is_dark: root.is_dark;
                                clicked => { root.action_stop_host(); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-height: 285px;
                background: root.is_dark ? #0d1527 : #ffffff;
                border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
                border-width: 1px;
                border-radius: 10px;
                clip: true;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 22px;
                        Text {
                            text: "环境与代理";
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            OutlineButton {
                                text: "检查补丁";
                                is_dark: root.is_dark;
                                clicked => { root.action_check_patch(); }
                            }
                            OutlineButton {
                                text: "打开目录";
                                is_dark: root.is_dark;
                                clicked => { root.action_open_app_dir(); }
                            }
                        }
                    }

                    PatchItemRow {
                        title: "Antigravity 桌面版";
                        status_text: root.patch_ag2_installed ? ("已汉化 (" + root.patch_ag2_version + ")") : (root.patch_ag2_version == "未安装" ? "未安装" : ("未汉化 (" + root.patch_ag2_version + ")"));
                        is_installed: root.patch_ag2_installed;
                        btn_text: root.patch_ag2_installed ? "卸载" : "安装";
                        is_dark: root.is_dark;
                        btn_clicked => { root.toggle_patch_ag2(); }
                    }

                    PatchItemRow {
                        title: "系统代理 (" + root.proxy_port_text + ")";
                        status_text: root.proxy_status_text;
                        is_installed: root.proxy_injected;
                        btn_text: root.proxy_injected ? "移除" : "注入";
                        is_dark: root.is_dark;
                        btn_clicked => { root.toggle_proxy(); }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 54px;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "总物理内存占用";
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 11px;
                                }
                                Text {
                                    text: root.total_mem_text;
                                    color: root.is_dark ? #f8fafc : #0f172a;
                                    font-size: 13.5px;
                                    font-weight: 700;
                                    font-family: "Cascadia Mono";
                                }
                            }
                            bar_mem := Rectangle {
                                height: 6px;
                                background: root.is_dark ? #141c2b : #e2e8f0;
                                border-radius: 3px;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: bar_mem.width * Math.min(1.0, Math.max(0.0, root.mem_host_pct));
                                    height: 6px;
                                    background: #38bdf8;
                                }
                                Rectangle {
                                    x: bar_mem.width * Math.min(1.0, Math.max(0.0, root.mem_host_pct));
                                    width: bar_mem.width * Math.min(1.0, Math.max(0.0, root.mem_subs_pct));
                                    height: 6px;
                                    background: #10b981;
                                }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: root.mem_detail_text;
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 10.5px;
                                    font-family: "Cascadia Mono";
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 48px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "沙箱运行时磁盘缓存";
                                    color: root.is_dark ? #f8fafc : #0f172a;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.cache_summary_text;
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 10.5px;
                                    font-family: "Cascadia Mono";
                                }
                            }
                            OutlineButton {
                                text: "清理缓存";
                                is_dark: root.is_dark;
                                clicked => { root.action_scan_cache(); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                min-width: 0px;
                preferred-width: 0px;
                max-height: 285px;
                background: root.is_dark ? #0d1527 : #ffffff;
                border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
                border-width: 1px;
                border-radius: 10px;
                clip: true;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 22px;
                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: root.live_session_is_running ? #10b981 : (root.is_dark ? #475569 : #94a3b8);
                                y: (parent.height - 8px) / 2;
                            }
                            Text {
                                text: "当前会话实时遥测";
                                color: root.is_dark ? #f8fafc : #0f172a;
                                font-size: 14px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: target_ta.has_hover ? (root.is_dark ? #1e293b : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);
                            border-color: root.is_dark ? #162032 : #cbd5e1;
                            border-width: 1px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                Text {
                                    text: root.live_session_target_text;
                                    color: #38bdf8;
                                    font-size: 11px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "▾";
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                            }
                            target_ta := TouchArea {
                                clicked => { root.switch_live_session_target(root.live_session_target_slot + 1); }
                                mouse-cursor: pointer;
                            }
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 44px;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 2px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: root.live_session_project;
                                    color: root.is_dark ? #f8fafc : #0f172a;
                                    font-size: 12px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.live_session_status_text;
                                    color: root.live_session_is_running ? #10b981 : (root.is_dark ? #64748b : #94a3b8);
                                    font-size: 11px;
                                    font-family: "Cascadia Mono";
                                }
                            }
                            Text {
                                text: root.live_session_title;
                                color: root.is_dark ? #94a3b8 : #64748b;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 62px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "单轮 Token 吞吐";
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 11px;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: root.live_session_speed_text;
                                        color: #10b981;
                                        font-size: 18px;
                                        font-weight: 700;
                                        font-family: "Cascadia Mono";
                                    }
                                    Text {
                                        text: "Tokens/s";
                                        color: root.is_dark ? #64748b : #94a3b8;
                                        font-size: 11px;
                                        font-family: "Cascadia Mono";
                                        vertical-alignment: bottom;
                                    }
                                }
                                Text {
                                    text: root.live_session_speed_sub;
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                }
                            }

                            HorizontalLayout {
                                spacing: 3px;
                                alignment: end;
                                Rectangle { width: 4px; height: root.live_bar0_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.35); y: parent.height - (root.live_bar0_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar1_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.45); y: parent.height - (root.live_bar1_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar2_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.55); y: parent.height - (root.live_bar2_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar3_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.65); y: parent.height - (root.live_bar3_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar4_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.75); y: parent.height - (root.live_bar4_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar5_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.85); y: parent.height - (root.live_bar5_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar6_h * 1px; border-radius: 2px; background: rgba(16, 185, 129, 0.90); y: parent.height - (root.live_bar6_h * 1px) - 14px; }
                                Rectangle { width: 4px; height: root.live_bar7_h * 1px; border-radius: 2px; background: #10b981; y: parent.height - (root.live_bar7_h * 1px) - 14px; }
                            }
                        }
                    }

                    Rectangle {
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.is_dark ? #162032 : #e2e8f0;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 56px;
                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 5px;
                            padding-bottom: 5px;
                            spacing: 3px;
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: "上下文容量深度";
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 11px;
                                }
                                Text {
                                    text: root.live_session_context_text;
                                    color: root.is_dark ? #f8fafc : #0f172a;
                                    font-size: 12px;
                                    font-weight: 700;
                                    font-family: "Cascadia Mono";
                                }
                            }
                            bar_ctx := Rectangle {
                                height: 6px;
                                background: root.is_dark ? #141c2b : #e2e8f0;
                                border-radius: 3px;
                                clip: true;
                                Rectangle {
                                    x: 0;
                                    width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_prompt_pct));
                                    height: 6px;
                                    background: #38bdf8;
                                }
                                Rectangle {
                                    x: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_prompt_pct));
                                    width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_cache_pct));
                                    height: 6px;
                                    background: #10b981;
                                }
                                Rectangle {
                                    x: bar_ctx.width * (Math.min(1.0, Math.max(0.0, root.live_prompt_pct)) + Math.min(1.0, Math.max(0.0, root.live_cache_pct)));
                                    width: bar_ctx.width * Math.min(1.0, Math.max(0.0, root.live_output_pct));
                                    height: 6px;
                                    background: #818cf8;
                                }
                            }
                            HorizontalLayout {
                                alignment: space-between;
                                Text {
                                    text: root.live_prompt_text;
                                    color: #38bdf8;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                }
                                Text {
                                    text: root.live_cache_legend;
                                    color: #10b981;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.live_output_text;
                                    color: #818cf8;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                }
                                Text {
                                    text: root.live_session_available_text;
                                    color: root.is_dark ? #64748b : #94a3b8;
                                    font-size: 10px;
                                    font-family: "Cascadia Mono";
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        height: 22px;
                        Text {
                            text: root.live_session_optimization_text;
                            color: root.is_dark ? #64748b : #94a3b8;
                            font-size: 11px;
                            font-family: "Cascadia Mono";
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 100px;
                            height: 22px;
                            Text {
                                text: "会话完整历史 >";
                                color: hist_ta.has_hover ? #38bdf8 : (root.is_dark ? #64748b : #94a3b8);
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: right;
                            }
                            hist_ta := TouchArea {
                                clicked => {
                                    root.session_modal_slot = root.live_session_target_slot;
                                    root.session_modal_visible = true;
                                    root.show_session_modal(root.live_session_target_slot);
                                }
                                mouse-cursor: pointer;
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
            vertical-stretch: 1;
            preferred-height: 430px;
            min-height: 360px;
            background: root.is_dark ? #0d1527 : #ffffff;
            border-color: root.is_dark ? rgba(56, 189, 248, 0.16) : #cbd5e1;
            border-width: 1px;
            border-radius: 10px;
            clip: true;

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;

                HorizontalLayout {
                    alignment: space-between;
                    height: 26px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "分身管理";
                            color: root.is_dark ? #f8fafc : #0f172a;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 5px;
                            border-color: root.is_pinned ? #38bdf8 : (pin_ta.has_hover ? (root.is_dark ? #334155 : #94a3b8) : (root.is_dark ? #1e293b : #cbd5e1));
                            border-width: 1px;
                            background: root.is_pinned ? (root.is_dark ? rgba(56, 189, 248, 0.22) : rgba(56, 189, 248, 0.16)) : (pin_ta.has_hover ? (root.is_dark ? #162032 : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc));

                            pin_ta := TouchArea {
                                clicked => { root.toggle_pin_window(); }
                                mouse-cursor: pointer;
                            }

                            PinIcon {
                                icon_color: root.is_pinned ? #38bdf8 : (pin_ta.has_hover ? (root.is_dark ? #cbd5e1 : #334155) : (root.is_dark ? #64748b : #94a3b8));
                                x: (parent.width - 12px) / 2;
                                y: (parent.height - 12px) / 2;
                            }
                        }

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 5px;
                            border-color: theme_ta.has_hover ? (root.is_dark ? #334155 : #94a3b8) : (root.is_dark ? #1e293b : #cbd5e1);
                            border-width: 1px;
                            background: theme_ta.has_hover ? (root.is_dark ? #162032 : #e2e8f0) : (root.is_dark ? #090e1c : #f8fafc);

                            theme_ta := TouchArea {
                                clicked => { root.toggle_theme(); }
                                mouse-cursor: pointer;
                            }

                            if root.is_dark : SunIcon {
                                icon_color: theme_ta.has_hover ? #f8fafc : #94a3b8;
                                x: (parent.width - 13px) / 2;
                                y: (parent.height - 13px) / 2;
                            }
                            if !root.is_dark : MoonIcon {
                                icon_color: theme_ta.has_hover ? #0f172a : #64748b;
                                x: (parent.width - 13px) / 2;
                                y: (parent.height - 13px) / 2;
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        background: root.is_dark ? #090e1c : #f8fafc;
                        border-color: root.sub1_running ? rgba(16, 185, 129, 0.45) : (root.is_dark ? #162032 : #e2e8f0);
                        border-width: 1px;
                        border-radius: 8px;
                        clip: true;

                        VerticalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 3px;

                            HorizontalLayout {
                                alignment: space-between;
                                height: 20px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Rectangle {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 3.5px;
